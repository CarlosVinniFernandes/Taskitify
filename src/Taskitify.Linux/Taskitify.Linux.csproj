<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>taskitify</AssemblyName>
    <RootNamespace>Taskitify.Linux</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Taskitify</Product>
    <Description>Synced Spotify lyrics on Linux (MPRIS).</Description>
    <Authors>Carlos Fernandes</Authors>
    <RepositoryUrl>https://github.com/CarlosVinniFernandes/Taskitify</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Framework messages only in the app's own languages. -->
    <SatelliteResourceLanguages>en;pt-BR;es;fr;de;it</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Taskitify.Core\Taskitify.Core.csproj" />
    <ProjectReference Include="..\Taskitify.Platform.Linux\Taskitify.Platform.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The translations and their loader are shared with the Windows app. -->
    <Compile Include="..\Taskitify\Services\LocalizationCatalog.cs" Link="Shared\LocalizationCatalog.cs" />
    <EmbeddedResource Include="..\Taskitify\Resources\Languages\*.json" LogicalName="Taskitify.Languages.%(Filename)%(Extension)" />
    <!-- The Spotify web player runs in this helper (WebKitGTK), next to the executable. -->
    <None Include="SpotifyWeb\spotify_web.py" Link="spotify_web.py" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="..\..\docs\images\logo.png" Link="Assets\taskitify.png" />
  </ItemGroup>

</Project>
