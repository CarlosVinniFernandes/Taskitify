<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK TFM gives access to Windows.Media.Control (GSMTC) through CsWinRT. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only for NotifyIcon (tray) and Screen; both ship with the Windows Desktop runtime. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Taskitify</AssemblyName>
    <RootNamespace>Taskitify</RootNamespace>
    <Version>1.0.4</Version>
    <Product>Taskitify</Product>
    <Description>Synced Spotify lyrics on the Windows 11 taskbar.</Description>
    <Authors>Carlos Fernandes</Authors>
    <Copyright>Copyright (c) 2026 Carlos Fernandes</Copyright>
    <RepositoryUrl>https://github.com/CarlosVinniFernandes/Taskitify</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationIcon>Resources\Taskitify.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- WinForms analyzer wants Application.SetHighDpiMode; this is a WPF app, so the manifest is right. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- Framework messages only in the app's own languages: the other 8 cost ~10 MB of the exe. -->
    <SatelliteResourceLanguages>en;pt-BR;es;fr;de;it</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms and WPF share type names (Application, Color, MessageBox...). Keep WinForms explicit. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window icons (pack URI) and the tray icon (embedded stream). -->
    <Resource Include="Resources\Taskitify.ico" />
    <!-- Lyric card typefaces (SIL Open Font License, see the .txt next to them). -->
    <Resource Include="Resources\Fonts\*.ttf" />
    <Resource Include="Resources\Tour\*.jpg" />
    <None Include="Resources\Fonts\*.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="Licenses" />
    <EmbeddedResource Include="Resources\Languages\*.json" LogicalName="Taskitify.Languages.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\Taskitify.ico" LogicalName="Taskitify.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Taskitify.Core\Taskitify.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <!--
    Package size (self-contained publish only; Debug builds and `dotnet run` are untouched).

    1. The CsWinRT projection of the whole Windows SDK (Microsoft.Windows.SDK.NET.dll, ~24 MB) is
       trimmed to the WinRT types Taskitify uses (media session, startup task, streams). CsWinRT is
       trim-annotated, so this is the supported path.
    2. Nothing else is trimmed. ILLink only reports which framework assemblies nothing references,
       and the ones listed in TaskitifyUnusedFrameworkAssembly are left out when it agrees. Every
       assembly that ships is the original, ReadyToRun-compiled file, byte for byte: rewriting them
       would drop their precompiled code and slow startup. WPF themes, UI Automation proxies and the
       facades WPF and XAML resolve by name are never on the list.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- WPF and WinForms are not trim-annotated: they are copied whole, never trimmed (see below). -->
    <_SuppressWpfTrimError>true</_SuppressWpfTrimError>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <!--
      PublishTrimmed also turns runtime features off. Keep them as an untrimmed publish has them:
      COM (WebView2, shell links, WPF), reflection-based JSON, custom resources, startup hooks.
    -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <CustomResourceTypesSupport>true</CustomResourceTypesSupport>
    <EnableCppCLIHostActivation>true</EnableCppCLIHostActivation>
    <_EnableConsumingManagedCodeFromNativeHosting>true</_EnableConsumingManagedCodeFromNativeHosting>
    <EnableGeneratedComInterfaceComImportInterop>true</EnableGeneratedComInterfaceComImportInterop>
    <StartupHookSupport>true</StartupHookSupport>
    <VerifyDependencyInjectionOpenGenericServiceTrimmability>false</VerifyDependencyInjectionOpenGenericServiceTrimmability>
  </PropertyGroup>

  <ItemGroup>
    <!-- Removed only if ILLink also finds no reference to them. Sizes are the uncompressed files. -->
    <TaskitifyUnusedFrameworkAssembly Include="System.Data.Common" />                 <!-- 2.7 MB -->
    <TaskitifyUnusedFrameworkAssembly Include="System.Private.DataContractSerialization" /> <!-- 2.0 MB -->
    <TaskitifyUnusedFrameworkAssembly Include="System.Windows.Controls.Ribbon" />     <!-- 1.4 MB -->
    <TaskitifyUnusedFrameworkAssembly Include="Microsoft.VisualBasic.Core" />         <!-- 1.2 MB -->
    <TaskitifyUnusedFrameworkAssembly Include="Microsoft.VisualBasic.Forms" />
    <TaskitifyUnusedFrameworkAssembly Include="Microsoft.CSharp" />                   <!-- 1.0 MB -->
    <TaskitifyUnusedFrameworkAssembly Include="System.Linq.Parallel" />
    <TaskitifyUnusedFrameworkAssembly Include="System.Transactions.Local" />
    <TaskitifyUnusedFrameworkAssembly Include="System.Net.HttpListener" />
    <TaskitifyUnusedFrameworkAssembly Include="System.Threading.Tasks.Dataflow" />
    <TaskitifyUnusedFrameworkAssembly Include="System.Net.Mail" />
    <TaskitifyUnusedFrameworkAssembly Include="System.Diagnostics.PerformanceCounter" />
    <TaskitifyUnusedFrameworkAssembly Include="System.Formats.Tar" />
    <TaskitifyUnusedFrameworkAssembly Include="System.Linq.Queryable" />
    <TaskitifyUnusedFrameworkAssembly Include="Microsoft.Web.WebView2.WinForms" />
  </ItemGroup>

  <Target Name="ConfigureSdkProjectionOnlyTrim" AfterTargets="PrepareForILLink">
    <ItemGroup>
      <!-- copy: the original file, byte for byte (ReadyToRun code included). -->
      <ManagedAssemblyToLink Condition="'%(Filename)' != 'Microsoft.Windows.SDK.NET'">
        <TrimMode>copy</TrimMode>
      </ManagedAssemblyToLink>
    </ItemGroup>
  </Target>

  <!--
    A second, throwaway ILLink run in copyused mode: an assembly is missing from its output only when
    nothing references it. Its files are never published.
  -->
  <Target Name="FindUnreferencedFrameworkAssemblies" AfterTargets="ConfigureSdkProjectionOnlyTrim" Condition="'$(PublishTrimmed)' == 'true'">
    <PropertyGroup>
      <_TaskitifyOracleDir>$(IntermediateOutputPath)unreferenced-check\</_TaskitifyOracleDir>
      <_TaskitifyDotNet Condition="'$(DOTNET_HOST_PATH)' != ''">$([System.IO.Path]::GetFileName('$(DOTNET_HOST_PATH)'))</_TaskitifyDotNet>
      <_TaskitifyDotNetDir Condition="'$(DOTNET_HOST_PATH)' != ''">$([System.IO.Path]::GetDirectoryName('$(DOTNET_HOST_PATH)'))</_TaskitifyDotNetDir>
      <_TaskitifyDotNet Condition="'$(DOTNET_HOST_PATH)' == ''">dotnet.exe</_TaskitifyDotNet>
      <_TaskitifyDotNetDir Condition="'$(DOTNET_HOST_PATH)' == ''">$(NetCoreRoot)</_TaskitifyDotNetDir>
    </PropertyGroup>
    <ItemGroup>
      <_TaskitifyOracleInput Include="@(ManagedAssemblyToLink)" TrimMode="copyused" />
    </ItemGroup>
    <RemoveDir Directories="$(_TaskitifyOracleDir)" />
    <ILLink AssemblyPaths="@(_TaskitifyOracleInput)"
            ReferenceAssemblyPaths="@(ReferencePath)"
            RootAssemblyNames="@(TrimmerRootAssembly)"
            TrimMode="copyused"
            OutputDirectory="$(_TaskitifyOracleDir)"
            ExtraArgs="--skip-unresolved true --notrimwarn"
            ToolExe="$(_TaskitifyDotNet)"
            ToolPath="$(_TaskitifyDotNetDir)" />
    <ItemGroup>
      <_TaskitifyUnreferencedName Include="@(ManagedAssemblyToLink->'%(Filename)')" Condition="!Exists('$(_TaskitifyOracleDir)%(Filename)%(Extension)')" />
      <!-- Listed and unreferenced. A listed assembly that something does use stays. -->
      <_TaskitifyListedButUsed Include="@(TaskitifyUnusedFrameworkAssembly)" Exclude="@(_TaskitifyUnreferencedName)" />
      <_TaskitifyLeaveOutName Include="@(TaskitifyUnusedFrameworkAssembly)" Exclude="@(_TaskitifyListedButUsed)" />
      <_TaskitifyLeaveOutName Include="@(_TaskitifyLeaveOutName->'%(Identity).resources')" />
    </ItemGroup>
    <Message Importance="high" Condition="'@(_TaskitifyListedButUsed)' != ''" Text="Taskitify publish: kept, now referenced: @(_TaskitifyListedButUsed, ', ')" />
  </Target>

  <!-- After the SDK has put ILLink's output into the publish set and the deps.json inputs. -->
  <Target Name="LeaveOutUnusedFrameworkAssemblies" AfterTargets="ILLink" Condition="'$(PublishTrimmed)' == 'true'">
    <JoinItems Left="@(ResolvedFileToPublish)" LeftKey="Filename" LeftMetadata="*" Right="@(_TaskitifyLeaveOutName)" ItemSpecToUse="Left">
      <Output TaskParameter="JoinResult" ItemName="_TaskitifyLeaveOutFile" />
    </JoinItems>
    <JoinItems Left="@(RuntimePackAsset)" LeftKey="Filename" LeftMetadata="*" Right="@(_TaskitifyLeaveOutName)" ItemSpecToUse="Left">
      <Output TaskParameter="JoinResult" ItemName="_TaskitifyLeaveOutAsset" />
    </JoinItems>
    <JoinItems Left="@(RuntimeCopyLocalItems)" LeftKey="Filename" LeftMetadata="*" Right="@(_TaskitifyLeaveOutName)" ItemSpecToUse="Left">
      <Output TaskParameter="JoinResult" ItemName="_TaskitifyLeaveOutCopyLocal" />
    </JoinItems>
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(_TaskitifyLeaveOutFile)" />
      <RuntimePackAsset Remove="@(_TaskitifyLeaveOutAsset)" />
      <RuntimeCopyLocalItems Remove="@(_TaskitifyLeaveOutCopyLocal)" />
    </ItemGroup>
    <Message Importance="high" Text="Taskitify publish: left out @(_TaskitifyLeaveOutFile->Count()) unused framework files" />
  </Target>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <!-- IntelliSense XML of the WebView2 package: never read at run time. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <!--
    Loaded only by a debugger attaching to the app, never by the app itself (there are no PDBs to
    read either). mscordaccore stays: Windows Error Reporting uses it for crash dumps.
  -->
  <Target Name="LeaveOutDebuggerOnlyRuntimeFiles" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(SelfContained)' == 'true' and '$(Configuration)' == 'Release'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'mscordbi.dll' or '%(Filename)%(Extension)' == 'Microsoft.DiaSymReader.Native.amd64.dll'" />
    </ItemGroup>
  </Target>

</Project>
