<Window x:Class="Taskitify.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taskitify"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/Taskitify.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="24,12,24,20">
        <TextBlock Text="{DynamicResource Loc.WelcomeHeading}" FontFamily="{StaticResource UiDisplayFont}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource SettingHint}" FontSize="13" Margin="0,6,0,14" Text="{DynamicResource Loc.WelcomeIntro}" />

        <Border Style="{StaticResource SettingCard}" Padding="16,14" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingLabel}" FontSize="14" FontWeight="SemiBold" Text="{DynamicResource Loc.WelcomeLrclibTitle}" />
                <TextBlock Style="{StaticResource SettingHint}" FontSize="13" Margin="0,4,0,12" Text="{DynamicResource Loc.WelcomeLrclibBody}" />
                <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Content="{DynamicResource Loc.WelcomeUseLrclib}" Click="OnUseLrclib" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingCard}" Padding="16,14">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingLabel}" FontSize="14" FontWeight="SemiBold" Text="{DynamicResource Loc.WelcomeSpotifyTitle}" />
                <TextBlock Style="{StaticResource SettingHint}" FontSize="13" Margin="0,4,0,10" Text="{DynamicResource Loc.WelcomeSpotifyBody}" />
                <!-- What the connection does to the account (nothing), stated where the choice is made. -->
                <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,1,10,0" VerticalAlignment="Top" />
                        <TextBlock TextWrapping="Wrap" Text="{DynamicResource Loc.WelcomeSpotifyPrivacy}" />
                    </DockPanel>
                </Border>
                <TextBlock Style="{StaticResource SettingHint}" Margin="0,0,0,12" Text="{DynamicResource Loc.WelcomeSpotifyUnofficial}" />
                <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Content="{DynamicResource Loc.WelcomeConnectSpotify}" Click="OnConnectSpotify" />
            </StackPanel>
        </Border>

        <DockPanel Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" VerticalAlignment="Center" Margin="12,0,0,0"
                    Content="{DynamicResource Loc.Settings}" Click="OnOpenSettings" />
            <TextBlock Style="{StaticResource SettingHint}" VerticalAlignment="Center" Margin="0" Text="{DynamicResource Loc.WelcomeChangeLater}" />
        </DockPanel>
    </StackPanel>
</Window>
