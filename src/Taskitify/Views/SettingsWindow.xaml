                                <StackPanel>
                                    <Border Width="76" Height="46" CornerRadius="4" BorderThickness="1.5" BorderBrush="{DynamicResource TextSecondaryBrush}" Background="{DynamicResource SubtleFillBrush}">
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,5">
                                            <Border Width="26" Height="2.5" CornerRadius="1.25" Background="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                            <Border Width="34" Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,2.5" />
                                            <Border Width="26" Height="2.5" CornerRadius="1.25" Background="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Loc.MinimalSpotBottomLeft}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FlatButton}" Padding="10,10,10,8" Margin="0,0,10,10" Command="{Binding MinimalLook.PlaceCommand}" CommandParameter="BottomRight"
                                    AutomationProperties.Name="{DynamicResource Loc.MinimalSpotBottomRight}" ToolTip="{DynamicResource Loc.MinimalSpotBottomRight}">
                                <StackPanel>
                                    <Border Width="76" Height="46" CornerRadius="4" BorderThickness="1.5" BorderBrush="{DynamicResource TextSecondaryBrush}" Background="{DynamicResource SubtleFillBrush}">
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6,5">
                                            <Border Width="26" Height="2.5" CornerRadius="1.25" Background="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                            <Border Width="34" Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,2.5" />
                                            <Border Width="26" Height="2.5" CornerRadius="1.25" Background="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Loc.MinimalSpotBottomRight}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupHeader}" Text="{DynamicResource Loc.Elements}" />
                    <Border Style="{StaticResource Group}" Padding="18,14,18,18">
                        <StackPanel>
                            <Border Style="{StaticResource Stage}">
                                <StackPanel>
                                    <local:MiniPlayerPicker HorizontalAlignment="Center" />
                                    <ContentControl Template="{StaticResource Legend}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Appearance: each part on its own, any layout with any background. -->
                    <TextBlock Style="{StaticResource GroupHeader}" Text="{DynamicResource Loc.LookMode}" />
                    <Border Style="{StaticResource Group}" Padding="18,14,18,8">
                        <ListBox Style="{StaticResource ChoiceList}" ItemContainerStyle="{StaticResource ThumbTile}" ItemsSource="{Binding MiniLook.Layouts}"
                                 SelectedItem="{Binding MiniLook.Layout}" AutomationProperties.Name="{DynamicResource Loc.LookMode}" />
                    </Border>

                    <TextBlock Style="{StaticResource GroupHeader}" Text="{DynamicResource Loc.LookTemplates}" />
                    <Border Style="{StaticResource Group}" Padding="18,14,18,14">
                        <StackPanel>
                            <ListBox Style="{StaticResource ChoiceList}" ItemContainerStyle="{StaticResource PresetTile}" ItemsSource="{Binding MiniLook.Presets}"
                                     SelectedItem="{Binding MiniLook.Preset}" AutomationProperties.Name="{DynamicResource Loc.LookTemplates}" />
                            <!-- The user's own looks: save the current one here; the one picked or saved can be renamed, updated or deleted. -->
                            <WrapPanel Margin="0,4,0,0">
                                <Button Style="{StaticResource AccentButton}" Command="{Binding MiniLook.SaveLookCommand}" Margin="0,0,16,6"
                                        AutomationProperties.Name="{DynamicResource Loc.LookSave}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Loc.LookSave}" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding MiniLook.IsEditing, Converter={StaticResource BoolToVisibility}}">
                                    <TextBox Style="{StaticResource NameField}" Width="190" MaxLength="40"
                                             Text="{Binding MiniLook.EditingName, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{DynamicResource Loc.LookName}" ToolTip="{DynamicResource Loc.LookName}" />
                                    <Button Style="{StaticResource FlatButton}" Command="{Binding MiniLook.UpdateLookCommand}" Margin="8,0,0,0"
                                            Content="{DynamicResource Loc.LookUpdate}" ToolTip="{DynamicResource Loc.LookUpdateHint}" />
                                    <Button Style="{StaticResource FlatButton}" Command="{Binding MiniLook.DeleteLookCommand}" Margin="8,0,0,0"
                                            Content="{DynamicResource Loc.LookDelete}" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.LookSaveHint}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupHeader}" Text="{DynamicResource Loc.LookBackground}" />
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <Border Style="{StaticResource FirstRow}" Padding="18,14,18,8">
                                <ListBox Style="{StaticResource ChoiceList}" ItemContainerStyle="{StaticResource ThumbTile}" ItemsSource="{Binding MiniLook.Backgrounds}"
                                         SelectedItem="{Binding MiniLook.Background}" AutomationProperties.Name="{DynamicResource Loc.LookBackground}" />
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <DockPanel IsEnabled="{Binding MiniLook.HasEffect}">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding MiniLook.EffectPercent, StringFormat={}{0:0}%}" />
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.LookEffect}" />
                                    </DockPanel>
                                    <Slider Minimum="30" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,8,0,0" IsEnabled="{Binding MiniLook.HasEffect}"
                                            Value="{Binding MiniLook.EffectPercent}" AutomationProperties.Name="{DynamicResource Loc.LookEffect}" />
                                    <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.LookEffectNone}"
                                               Visibility="{Binding MiniLook.NoEffect, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <DockPanel IsEnabled="{Binding MiniLook.HasDim}">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding MiniLook.DimPercent, StringFormat={}{0:0}%}" />
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.LookDim}" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,8,0,0" IsEnabled="{Binding MiniLook.HasDim}"
                                            Value="{Binding MiniLook.DimPercent}" AutomationProperties.Name="{DynamicResource Loc.LookDim}" />
                                    <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.LookDimNone}"
                                               Visibility="{Binding MiniLook.NoDim, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <DockPanel IsEnabled="{Binding MiniLook.HasBlur}">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding MiniLook.BlurPercent, StringFormat={}{0:0}%}" />
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.LookBlur}" />
                                    </DockPanel>
                                    <Slider Minimum="40" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,8,0,0" IsEnabled="{Binding MiniLook.HasBlur}"
                                            Value="{Binding MiniLook.BlurPercent}" AutomationProperties.Name="{DynamicResource Loc.LookBlur}" />
                                    <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.LookBlurNone}"
                                               Visibility="{Binding MiniLook.NoBlur, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupHeader}" Text="{DynamicResource Loc.LookLyrics}" />
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <Border Style="{StaticResource FirstRow}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.LookHighlight}" />
                                    <ListBox Style="{StaticResource ChoiceList}" ItemContainerStyle="{StaticResource ThumbTile}" ItemsSource="{Binding MiniLook.Highlights}"
                                             SelectedItem="{Binding MiniLook.Highlight}" Margin="0,8,0,0" AutomationProperties.Name="{DynamicResource Loc.LookHighlight}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.MotionTitle}" />
                                    <ListBox Style="{StaticResource ChoiceList}" ItemContainerStyle="{StaticResource ThumbTile}" ItemsSource="{Binding MiniLook.Motions}"
                                             SelectedItem="{Binding MiniLook.Motion}" Margin="0,8,0,0" AutomationProperties.Name="{DynamicResource Loc.MotionTitle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.LookAlignment}" />
                                    <ListBox Style="{StaticResource ChoiceList}" ItemContainerStyle="{StaticResource ThumbTile}" ItemsSource="{Binding MiniLook.Alignments}"
                                             SelectedItem="{Binding MiniLook.Alignment}" Margin="0,8,0,0" AutomationProperties.Name="{DynamicResource Loc.LookAlignment}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.LookTypeface}" />
                                    <ListBox Style="{StaticResource ChoiceList}" ItemContainerStyle="{StaticResource ThumbTile}" ItemsSource="{Binding MiniLook.Typefaces}"
                                             SelectedItem="{Binding MiniLook.Typeface}" Margin="0,8,0,0" AutomationProperties.Name="{DynamicResource Loc.LookTypeface}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding MiniLook.LyricsPercent, StringFormat={}{0:0}%}" />
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.LookLyricsSize}" />
                                    </DockPanel>
                                    <Slider Minimum="80" Maximum="140" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,8,0,0"
                                            Value="{Binding MiniLook.LyricsPercent}" AutomationProperties.Name="{DynamicResource Loc.LookLyricsSize}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupHeader}" Text="{DynamicResource Loc.LookControls}" />
                    <Border Style="{StaticResource Group}">
                        <Border Style="{StaticResource FirstRow}">
                            <ListBox Style="{StaticResource ChoiceList}" ItemContainerStyle="{StaticResource ThumbTile}" ItemsSource="{Binding MiniLook.Controls}"
                                     SelectedItem="{Binding MiniLook.ControlsStyle}" AutomationProperties.Name="{DynamicResource Loc.LookControls}" />
                        </Border>
                    </Border>

                    <TextBlock Style="{StaticResource GroupHeader}" Text="{DynamicResource Loc.Size}" />
                    <Border Style="{StaticResource Group}">
                        <Border Style="{StaticResource FirstRow}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding MiniPlayer.Width, StringFormat={}{0} px}" />
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.Width}" />
                                </DockPanel>
                                <Slider Minimum="{Binding MiniPlayer.MinWidth, Mode=OneTime}" Maximum="{Binding MiniPlayer.MaxWidth, Mode=OneTime}" TickFrequency="10" Margin="0,8,0,0"
                                        Value="{Binding MiniPlayer.Width}" AutomationProperties.Name="{DynamicResource Loc.LyricsPlayerWidth}" />
                            </StackPanel>
                        </Border>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ───────────── Lyrics ───────────── -->
        <TabItem Style="{StaticResource NavItem}" Header="{DynamicResource Loc.NavLyrics}" Tag="&#xE8D2;">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel Style="{StaticResource PageBody}">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Loc.NavLyrics}" />
                    <TextBlock Style="{StaticResource PageHint}" Text="{DynamicResource Loc.PageLyricsHint}" />

                    <TextBlock Style="{StaticResource GroupHeader}" Text="{DynamicResource Loc.FlowTitle}" />
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <Border Style="{StaticResource FirstRow}">
                                <DockPanel>
                                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding TaskbarFlowOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding TaskbarLyricFlow}"
                                              AutomationProperties.Name="{DynamicResource Loc.FlowTitle}" />
                                    <StackPanel Style="{StaticResource RowText}">
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.FlowTitle}" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.FlowBothHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupHeader}" Text="{DynamicResource Loc.LyricsSource}" />
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <Border Style="{StaticResource FirstRow}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.SpotifyLyricsTitle}" />
                                    <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.SpotifyLyricsHint}" />
                                    <Border CornerRadius="4" Padding="10,6" Margin="0,10,0,0" HorizontalAlignment="Left" Background="{DynamicResource SubtleFillBrush}">
                                        <TextBlock x:Name="SpotifyLyricsStatus" TextWrapping="Wrap" FontSize="13" />
                                    </Border>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button x:Name="ConnectSpotifyButton" Style="{StaticResource AccentButton}" Content="{DynamicResource Loc.SpotifyLyricsConnect}" Click="OnConnectSpotify" Margin="0,0,8,0" />
                                        <Button x:Name="DisconnectSpotifyButton" Style="{StaticResource FlatButton}" Content="{DynamicResource Loc.SpotifyLyricsDisconnect}" Click="OnDisconnectSpotify" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" VerticalAlignment="Center" Content="{DynamicResource Loc.OpenFolder}"
                                            Command="{Binding OpenLyricsFolderCommand}" AutomationProperties.Name="{DynamicResource Loc.OpenLyricsFolder}" />
                                    <StackPanel Style="{StaticResource RowText}">
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.LocalLyrics}" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.OpenLyricsFolderHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" VerticalAlignment="Center" Content="{DynamicResource Loc.ClearCache}"
                                            Command="{Binding ClearCacheCommand}" />
                                    <StackPanel Style="{StaticResource RowText}">
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.LyricsCache}" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.LyricsCacheHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupHeader}" Text="{DynamicResource Loc.Sync}" />
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                        <Border Style="{StaticResource FirstRow}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding SyncOffsetMs, StringFormat={}{0:+0;-0;0} ms}" />
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.OffsetAll}" />
                                </DockPanel>
                                <Slider Minimum="-3000" Maximum="3000" TickFrequency="50" Margin="0,8,0,0"
                                        Value="{Binding SyncOffsetMs}" AutomationProperties.Name="{DynamicResource Loc.OffsetAll}" />
                                <DockPanel Margin="0,8,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource FlatButton}" Content="−250 ms" Click="OnOffsetMinus" />
                                        <Button Style="{StaticResource FlatButton}" Content="{DynamicResource Loc.Reset}" Margin="6,0" Click="OnOffsetReset" />
                                        <Button Style="{StaticResource FlatButton}" Content="+250 ms" Click="OnOffsetPlus" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SettingHint}" VerticalAlignment="Center" Margin="0,0,16,0" Text="{DynamicResource Loc.OffsetHint}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <!-- This song only: added to the adjustment above, found again whenever the song plays. -->
                        <Border Style="{StaticResource Row}" IsEnabled="{Binding HasTrack}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueText}" Text="{Binding TrackOffsetMs, StringFormat={}{0:+0;-0;0} ms}" />
                                    <StackPanel Style="{StaticResource RowText}">
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.TrackOffset}" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="{Binding TrackName}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                                <Slider Minimum="-3000" Maximum="3000" TickFrequency="50" IsSnapToTickEnabled="True" Margin="0,8,0,0"
                                        Value="{Binding TrackOffsetMs}" AutomationProperties.Name="{DynamicResource Loc.TrackOffset}" />
                                <DockPanel Margin="0,8,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource FlatButton}" Content="−100 ms" Click="OnTrackOffsetMinus" />
                                        <Button Style="{StaticResource FlatButton}" Content="{DynamicResource Loc.Reset}" Margin="6,0" Click="OnTrackOffsetReset" />
                                        <Button Style="{StaticResource FlatButton}" Content="+100 ms" Click="OnTrackOffsetPlus" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SettingHint}" VerticalAlignment="Center" Margin="0,0,16,0" Text="{DynamicResource Loc.TrackOffsetHint}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <!-- What is applied now, and the way back for every song at once. -->
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" VerticalAlignment="Center"
                                        Command="{Binding ClearTrackOffsetsCommand}">
                                    <TextBlock>
                                        <Run Text="{DynamicResource Loc.TrackOffsetsClear}" /><Run Text="{Binding TrackOffsetCount, StringFormat={} ({0}), Mode=OneWay}" />
                                    </TextBlock>
                                </Button>
                                <StackPanel Style="{StaticResource RowText}">
                                    <TextBlock Style="{StaticResource SettingLabel}">
                                        <Run Text="{DynamicResource Loc.OffsetApplied}" /><Run Text=": " /><Run FontWeight="SemiBold" Text="{Binding EffectiveOffsetMs, StringFormat={}{0:+0;-0;0} ms, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.OffsetAppliedHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ───────────── Position ───────────── -->
        <TabItem Style="{StaticResource NavItem}" Header="{DynamicResource Loc.Position}" Tag="&#xE7F4;">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel Style="{StaticResource PageBody}">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Loc.Position}" />
                    <TextBlock Style="{StaticResource PageHint}" Text="{DynamicResource Loc.PagePositionHint}" />

                    <Border Style="{StaticResource Group}" Margin="0,24,0,0">
                        <StackPanel>
                            <Border Style="{StaticResource FirstRow}">
                                <DockPanel>
                                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Monitors}" DisplayMemberPath="Label"
                                              SelectedValuePath="DeviceName" SelectedValue="{Binding MonitorDeviceName}"
                                              AutomationProperties.Name="{DynamicResource Loc.Monitor}" />
                                    <StackPanel Style="{StaticResource RowText}">
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.Monitor}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsCalibrating}" AutomationProperties.Name="{DynamicResource Loc.Calibration}" />
                                    <StackPanel Style="{StaticResource RowText}">
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.Calibration}" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.CalibrationHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" VerticalAlignment="Center"
                                            Content="{DynamicResource Loc.AutoPosition}" Command="{Binding ResetPlacementCommand}" />
                                    <StackPanel Style="{StaticResource RowText}">
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.AutoPositionLabel}" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.AutoPositionHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ───────────── Advanced ───────────── -->
        <TabItem Style="{StaticResource NavItem}" Header="{DynamicResource Loc.Advanced}" Tag="&#xE90F;">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel Style="{StaticResource PageBody}">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Loc.Advanced}" />
                    <TextBlock Style="{StaticResource PageHint}" Text="{DynamicResource Loc.PageAdvancedHint}" />

                    <Border Style="{StaticResource Group}" Margin="0,24,0,0">
                        <StackPanel>
                            <Border Style="{StaticResource FirstRow}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DebugMode}" AutomationProperties.Name="{DynamicResource Loc.DebugMode}" />
                                    <StackPanel Style="{StaticResource RowText}">
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.DebugMode}" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.DebugHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" VerticalAlignment="Center" Content="{DynamicResource Loc.OpenFolder}"
                                            Command="{Binding OpenDataFolderCommand}" AutomationProperties.Name="{DynamicResource Loc.OpenData}" />
                                    <StackPanel Style="{StaticResource RowText}">
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.AppData}" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.AppDataHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource FlatButton}" Command="{Binding OpenRepositoryCommand}" Margin="0" AutomationProperties.Name="{DynamicResource Loc.RepositoryOpen}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE943;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{DynamicResource Loc.RepositoryOpen}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource RowText}">
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.RepositoryLabel}" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.RepositoryHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
