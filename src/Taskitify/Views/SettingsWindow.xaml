<Window x:Class="Taskitify.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Taskitify.Views"
        Title="{DynamicResource Loc.SettingsTitle}"
        Width="520" Height="720" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/Taskitify.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- The stock ComboBox chrome is light in both themes; keep its text dark. -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,24">
            <TextBlock Text="Taskitify" FontFamily="{StaticResource UiDisplayFont}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.Description}" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.General}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.Language}" />
                    <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Name" Margin="0,6,0,0"
                              SelectedValuePath="Code" SelectedValue="{Binding Language}"
                              AutomationProperties.Name="{DynamicResource Loc.Language}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="{DynamicResource Loc.Startup}" />
                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.Startup}" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowTrayIcon}" AutomationProperties.Name="{DynamicResource Loc.TrayIcon}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.TrayIcon}" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.TrayHint}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EnableAnimations}" AutomationProperties.Name="{DynamicResource Loc.Animations}" />
                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.Animations}" />
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.Style}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.BuildBar}" />
                    <TextBlock Style="{StaticResource SettingHint}"
                               Text="{DynamicResource Loc.PickerHint}" />
                    <local:PlayerPicker DataContext="{Binding Bar}" Margin="0,12,0,4" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.WhenPaused}" />
                    <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.MinimizeHint}" />
                    <ComboBox ItemsSource="{Binding PausedOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding PausedBehavior}" AutomationProperties.Name="{DynamicResource Loc.WhenPaused}"
                              VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}" IsEnabled="{Binding IsMinimizeOnPause}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.CompactStyle}" />
                    <TextBlock Style="{StaticResource SettingHint}"
                               Text="{DynamicResource Loc.CompactHint}" />
                    <local:PlayerPicker DataContext="{Binding MinimizedBar}" Margin="0,12,0,8" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MinimizedBar.Width, StringFormat={}{0} px}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.Width}" />
                    </DockPanel>
                    <Slider Minimum="60" Maximum="600" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                            Value="{Binding MinimizedBar.Width}" AutomationProperties.Name="{DynamicResource Loc.CompactWidth}" />
                    <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.CompactWidthHint}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.Progress}" />
                    <ComboBox ItemsSource="{Binding ProgressPlacementOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding ProgressPlacement}" AutomationProperties.Name="{DynamicResource Loc.ProgressPosition}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.Background}" />
                    <ComboBox ItemsSource="{Binding BackgroundOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding Background}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.PrimaryText}" />
                    <ComboBox ItemsSource="{Binding PrimaryTextOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding PrimaryText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.NoSyncedLyrics}" />
                    <ComboBox ItemsSource="{Binding NoLyricsOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding NoLyricsBehavior}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MarqueeLongText}" AutomationProperties.Name="{DynamicResource Loc.ScrollText}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.ScrollText}" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.ScrollHint}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.Size}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Bar.Width, StringFormat={}{0} px}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.WidgetWidth}" />
                    </DockPanel>
                    <Slider Minimum="100" Maximum="900" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                            Value="{Binding Bar.Width}" AutomationProperties.Name="{DynamicResource Loc.WidgetWidth}" />
                    <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.WidthHint}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding FontSize, StringFormat={}{0} pt}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.FontSize}" />
                    </DockPanel>
                    <Slider Minimum="9" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                            Value="{Binding FontSize}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.Sync}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SyncOffsetMs, StringFormat={}{0:+0;-0;0} ms}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.Offset}" />
                    </DockPanel>
                    <Slider Minimum="-3000" Maximum="3000" TickFrequency="50" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                            Value="{Binding SyncOffsetMs}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Style="{StaticResource FlatButton}" Content="−250 ms" Click="OnOffsetMinus" />
                        <Button Style="{StaticResource FlatButton}" Content="{DynamicResource Loc.Reset}" Margin="6,0" Click="OnOffsetReset" />
                        <Button Style="{StaticResource FlatButton}" Content="+250 ms" Click="OnOffsetPlus" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.OffsetHint}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.Position}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.Monitor}" />
                    <ComboBox ItemsSource="{Binding Monitors}" DisplayMemberPath="Label"
                              SelectedValuePath="DeviceName" SelectedValue="{Binding MonitorDeviceName}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsCalibrating}" AutomationProperties.Name="{DynamicResource Loc.Calibration}" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.Calibration}" />
                            <TextBlock Style="{StaticResource SettingHint}"
                                       Text="{DynamicResource Loc.CalibrationHint}" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource FlatButton}" Content="{DynamicResource Loc.AutoPosition}" Command="{Binding ResetPlacementCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Loc.Advanced}" />
            <Border Style="{StaticResource SettingCard}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DebugMode}" AutomationProperties.Name="{DynamicResource Loc.DebugMode}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource Loc.DebugMode}" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="{DynamicResource Loc.DebugHint}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <WrapPanel Margin="0,8,0,0">
                <Button Style="{StaticResource FlatButton}" Content="{DynamicResource Loc.ClearCache}" Margin="0,0,6,6" Command="{Binding ClearCacheCommand}" />
                <Button Style="{StaticResource FlatButton}" Content="{DynamicResource Loc.OpenData}" Margin="0,0,0,6" Command="{Binding OpenDataFolderCommand}" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
