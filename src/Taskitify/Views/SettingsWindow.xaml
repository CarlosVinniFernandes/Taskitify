<Window x:Class="Taskitify.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Taskitify.Views"
        Title="Taskitify — Configurações"
        Width="520" Height="720" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/Taskitify.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- The stock ComboBox chrome is light in both themes; keep its text dark. -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,24">
            <TextBlock Text="Taskitify" FontFamily="{StaticResource UiDisplayFont}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource SettingHint}" Text="Letras sincronizadas do Spotify no lugar do clima da barra de tarefas." />

            <TextBlock Style="{StaticResource SectionHeader}" Text="Geral" />
            <Border Style="{StaticResource SettingCard}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="Iniciar com o Windows" />
                    <TextBlock Style="{StaticResource SettingLabel}" Text="Iniciar com o Windows" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowTrayIcon}" AutomationProperties.Name="Ícone na área de notificação" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Ícone na área de notificação" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="Sem o ícone, abra as configurações pelo clique direito na letra ou executando o app de novo." />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EnableAnimations}" AutomationProperties.Name="Animações" />
                    <TextBlock Style="{StaticResource SettingLabel}" Text="Animações" />
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Estilo" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="Monte a sua barra" />
                    <TextBlock Style="{StaticResource SettingHint}"
                               Text="Clique nos elementos, inclusive na letra: verde aparece na barra de tarefas, branco fica escondido." />
                    <local:PlayerPicker DataContext="{Binding Bar}" Margin="0,12,0,4" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <DockPanel>
                    <ComboBox DockPanel.Dock="Right" Width="230" ItemsSource="{Binding PausedOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding PausedBehavior}" AutomationProperties.Name="Ao pausar a música"
                              VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Ao pausar a música" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="Minimizar: mostra o player minimizado, configurado logo abaixo." />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}" IsEnabled="{Binding IsMinimizeOnPause}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="Estilo do player minimizado" />
                    <TextBlock Style="{StaticResource SettingHint}"
                               Text="Aparece no lugar do clima enquanto a música está pausada (escolha &quot;Minimizar o player&quot; acima)." />
                    <local:PlayerPicker DataContext="{Binding MinimizedBar}" Margin="0,12,0,8" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MinimizedBar.Width, StringFormat={}{0} px}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Largura" />
                    </DockPanel>
                    <Slider Minimum="60" Maximum="600" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                            Value="{Binding MinimizedBar.Width}" AutomationProperties.Name="Largura do player minimizado" />
                    <TextBlock Style="{StaticResource SettingHint}" Text="Espaço para capa e texto; os botões somam por cima. Nunca fica menor que o clima." />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <DockPanel>
                    <ComboBox DockPanel.Dock="Right" Width="250" ItemsSource="{Binding ProgressPlacementOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding ProgressPlacement}" AutomationProperties.Name="Posição da barra de progresso" />
                    <TextBlock Style="{StaticResource SettingLabel}" Text="Barra de progresso" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <DockPanel>
                    <ComboBox DockPanel.Dock="Right" Width="230" ItemsSource="{Binding BackgroundOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding Background}" />
                    <TextBlock Style="{StaticResource SettingLabel}" Text="Fundo" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <DockPanel>
                    <ComboBox DockPanel.Dock="Right" Width="230" ItemsSource="{Binding PrimaryTextOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding PrimaryText}" />
                    <TextBlock Style="{StaticResource SettingLabel}" Text="Texto principal" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <DockPanel>
                    <ComboBox DockPanel.Dock="Right" Width="210" ItemsSource="{Binding NoLyricsOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding NoLyricsBehavior}" />
                    <TextBlock Style="{StaticResource SettingLabel}" Text="Sem letra sincronizada" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MarqueeLongText}" AutomationProperties.Name="Rolar texto que não cabe" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Rolar texto que não cabe" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="Em vez de cortar com “…”. Usa um pouco mais de CPU enquanto rola." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Tamanho" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Bar.Width, StringFormat={}{0} px}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Largura do widget" />
                    </DockPanel>
                    <Slider Minimum="100" Maximum="900" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                            Value="{Binding Bar.Width}" AutomationProperties.Name="Largura do widget" />
                    <TextBlock Style="{StaticResource SettingHint}" Text="Espaço para capa e letra; os botões somam por cima. Nunca fica menor que o clima nem cobre outros botões da barra." />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding FontSize, StringFormat={}{0} pt}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Tamanho da fonte" />
                    </DockPanel>
                    <Slider Minimum="9" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                            Value="{Binding FontSize}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Sincronização" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SyncOffsetMs, StringFormat={}{0:+0;-0;0} ms}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Ajuste de tempo (offset)" />
                    </DockPanel>
                    <Slider Minimum="-3000" Maximum="3000" TickFrequency="50" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                            Value="{Binding SyncOffsetMs}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Style="{StaticResource FlatButton}" Content="−250 ms" Click="OnOffsetMinus" />
                        <Button Style="{StaticResource FlatButton}" Content="Zerar" Margin="6,0" Click="OnOffsetReset" />
                        <Button Style="{StaticResource FlatButton}" Content="+250 ms" Click="OnOffsetPlus" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SettingHint}" Text="Positivo adianta a letra; negativo atrasa." />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Posição" />
            <Border Style="{StaticResource SettingCard}">
                <DockPanel>
                    <ComboBox DockPanel.Dock="Right" Width="230" ItemsSource="{Binding Monitors}" DisplayMemberPath="Label"
                              SelectedValuePath="DeviceName" SelectedValue="{Binding MonitorDeviceName}" />
                    <TextBlock Style="{StaticResource SettingLabel}" Text="Monitor" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsCalibrating}" AutomationProperties.Name="Modo de calibração" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingLabel}" Text="Modo de calibração" />
                            <TextBlock Style="{StaticResource SettingHint}"
                                       Text="Mostra o widget com borda tracejada mesmo sem música. Arraste para mover; use a roda do mouse para mudar a largura. A posição manual substitui a detecção automática." />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource FlatButton}" Content="Voltar à posição automática" Command="{Binding ResetPlacementCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Avançado" />
            <Border Style="{StaticResource SettingCard}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DebugMode}" AutomationProperties.Name="Modo de depuração" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Modo de depuração" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="Grava log em arquivo e habilita a janela de diagnóstico no menu da bandeja." />
                    </StackPanel>
                </DockPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource FlatButton}" Content="Limpar cache de letras" Command="{Binding ClearCacheCommand}" />
                <Button Style="{StaticResource FlatButton}" Content="Abrir pasta de dados" Margin="6,0,0,0" Command="{Binding OpenDataFolderCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
