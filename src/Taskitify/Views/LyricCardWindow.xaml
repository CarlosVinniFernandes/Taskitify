<Window x:Class="Taskitify.Views.LyricCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.LyricCardTitle}"
        Width="1100" Height="800" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/Taskitify.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
        <Style TargetType="Slider" BasedOn="{StaticResource SettingsSlider}" />

        <Style x:Key="Group" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- The three tabs: a segmented control, the current one filled. -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Padding="10,7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Choice chip (format, font, alignment, signature), accent outline when chosen. -->
        <Style x:Key="Chip" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="16" Padding="13,6" Background="{DynamicResource SubtleFillHoverBrush}"
                                BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bg" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bg" Property="Padding" Value="12,5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style gallery: the style drawn with the chosen lines, and its name. -->
        <Style x:Key="StyleTile" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,12" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel Width="114">
                            <Grid Width="114" Height="114">
                                <Border CornerRadius="9" Background="{DynamicResource SubtleFillHoverBrush}" />
                                <Border CornerRadius="7" Margin="3">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Border x:Name="Ring" CornerRadius="9" BorderThickness="2" BorderBrush="Transparent" />
                                <Border x:Name="Check" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0" Visibility="Collapsed">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock x:Name="Name" Text="{Binding Label}" FontSize="12" Margin="2,6,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
                                <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwatchItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="ToolTip" Value="{Binding Label}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Width="32" Height="32">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" Opacity="0" />
                            <Ellipse Margin="4" Fill="{Binding Brush}" Stroke="{DynamicResource PopupBorderBrush}" StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Choices" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="T" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>

        <!-- Preview: the exported card itself, scaled to fit; nothing of the window is in it. -->
        <Border Background="{DynamicResource ControlBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- The shadow is its own layer: an effect over the image would re-rasterise it unsmoothed. -->
                <Viewbox Margin="32,32,32,10" Stretch="Uniform">
                    <Grid Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}">
                        <Border Background="Black">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="70" ShadowDepth="12" Direction="270" Opacity="0.45" Color="Black" />
                            </Border.Effect>
                        </Border>
                        <Image Source="{Binding Preview}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Viewbox>
                <TextBlock Grid.Row="1" Text="{Binding Credit}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,14"
                           Foreground="{DynamicResource TextTertiaryBrush}" Visibility="{Binding Credit, Converter={StaticResource NullToCollapsed}}" />

            </Grid>
        </Border>

        <!-- Settings -->
        <DockPanel Grid.Column="1" Margin="24,20,22,20">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{DynamicResource Loc.LyricCardTitle}" FontFamily="{StaticResource UiDisplayFont}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Title, Mode=OneWay}" /> · <Run Text="{Binding Artist, Mode=OneWay}" />
                </TextBlock>

                <Border Margin="0,16,0,4" Padding="3" CornerRadius="8" Background="{DynamicResource SubtleFillBrush}"
                        BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1">
                    <UniformGrid Columns="3">
                        <Button Command="{Binding SelectTabCommand}" CommandParameter="0" AutomationProperties.Name="{DynamicResource Loc.CardTabLines}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tab}" Value="0"><Setter Property="Tag" Value="True" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Loc.CardTabLines}" />
                                <Border Margin="7,0,0,0" Padding="6,0,6,1" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                                    <TextBlock Text="{Binding Counter}" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectTabCommand}" CommandParameter="1" Content="{DynamicResource Loc.CardTabStyle}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tab}" Value="1"><Setter Property="Tag" Value="True" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding SelectTabCommand}" CommandParameter="2" Content="{DynamicResource Loc.CardTabCustomize}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tab}" Value="2"><Setter Property="Tag" Value="True" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>
                </Border>
            </StackPanel>

            <!-- Export -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,0,0,8" MinHeight="16" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource FlatButton}" Command="{Binding SaveCommand}" Padding="12,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Loc.CardSave}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource AccentButton}" Command="{Binding CopyCommand}" Padding="12,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Loc.CardCopy}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <Grid>
                <!-- Tab 0: lines -->
                <DockPanel>
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tab}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <Grid DockPanel.Dock="Top" Margin="0,12,0,8">
                        <TextBlock Text="{DynamicResource Loc.CardLinesHint}" Style="{StaticResource Hint}" Margin="0,0,80,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource LinkButton}" Command="{Binding ClearCommand}" Content="{DynamicResource Loc.CardClear}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Border CornerRadius="8" Background="{DynamicResource SubtleFillBrush}" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1">
                        <Grid>
                            <ScrollViewer x:Name="LinesScroll" VerticalScrollBarVisibility="Auto" Padding="4">
                                <ItemsControl ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton IsChecked="{Binding IsSelected}" Cursor="Hand" Margin="0,1" AutomationProperties.Name="{Binding Text}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Bg" CornerRadius="6" Padding="10,7" Background="Transparent">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Top">
                                                                    <Ellipse x:Name="Circle" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" />
                                                                    <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                                                </Grid>
                                                                <TextBlock x:Name="Text" Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="11" Margin="8,2,0,0"
                                                                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Top" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}" />
                                                                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}" />
                                                                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
                                                                <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                                <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="{DynamicResource Loc.CardNoLyrics}" TextAlignment="Center" VerticalAlignment="Center" Margin="20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasLines}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DockPanel>

                <!-- Tab 1: style and format -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tab}" Value="1"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel Margin="0,4,4,0">
                        <TextBlock Style="{StaticResource Group}" Text="{DynamicResource Loc.CardStyle}" Margin="0,10,0,10" />
                        <ListBox Style="{StaticResource Choices}" ItemContainerStyle="{StaticResource StyleTile}" ItemsSource="{Binding StyleItems}"
                                 SelectedItem="{Binding SelectedStyle}" AutomationProperties.Name="{DynamicResource Loc.CardStyle}" />
                        <TextBlock Style="{StaticResource Group}" Text="{DynamicResource Loc.CardFormat}" Margin="0,6,0,8" />
                        <ListBox Style="{StaticResource Choices}" ItemContainerStyle="{StaticResource Chip}" ItemsSource="{Binding Formats}"
                                 SelectedItem="{Binding SelectedFormat}" AutomationProperties.Name="{DynamicResource Loc.CardFormat}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Tab 2: customize -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tab}" Value="2"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource Group}" Text="{DynamicResource Loc.CardFont}" />
                        <ListBox Style="{StaticResource Choices}" ItemContainerStyle="{StaticResource Chip}" ItemsSource="{Binding Fonts}"
                                 SelectedItem="{Binding SelectedFont}" AutomationProperties.Name="{DynamicResource Loc.CardFont}" />

                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="{DynamicResource Loc.CardFontSize}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding FontPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <Slider Minimum="60" Maximum="150" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding FontPercent}" Margin="0,6,0,0" AutomationProperties.Name="{DynamicResource Loc.CardFontSize}" />

                        <TextBlock Style="{StaticResource Group}" Text="{DynamicResource Loc.CardAlign}" />
                        <ListBox Style="{StaticResource Choices}" ItemContainerStyle="{StaticResource Chip}" ItemsSource="{Binding Aligns}"
                                 SelectedItem="{Binding SelectedAlign}" AutomationProperties.Name="{DynamicResource Loc.CardAlign}" />

                        <TextBlock Style="{StaticResource Group}" Text="{DynamicResource Loc.CardColor}" />
                        <ListBox Style="{StaticResource Choices}" ItemContainerStyle="{StaticResource SwatchItem}" ItemsSource="{Binding Swatches}"
                                 SelectedItem="{Binding SelectedSwatch}" AutomationProperties.Name="{DynamicResource Loc.CardColor}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{DynamicResource Loc.CardCustomColor}" VerticalAlignment="Center" FontSize="13" Margin="0,0,10,0" />
                            <TextBox Style="{StaticResource Field}" Width="110" FontFamily="Consolas"
                                     Text="{Binding CustomColor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Loc.CardCustomColor}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Group}" Text="{DynamicResource Loc.CardMark}" />
                        <ListBox Style="{StaticResource Choices}" ItemContainerStyle="{StaticResource Chip}" ItemsSource="{Binding Marks}"
                                 SelectedItem="{Binding SelectedMark}" AutomationProperties.Name="{DynamicResource Loc.CardMark}" />

                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowCover}" Margin="0,16,0,0"
                                  Content="{DynamicResource Loc.CardShowCover}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowTimestamp}" Margin="0,12,0,0" IsEnabled="{Binding CanShowTimestamp}"
                                  Content="{DynamicResource Loc.CardShowTimestamp}" Foreground="{DynamicResource TextPrimaryBrush}" />

                        <TextBlock Style="{StaticResource Group}" Text="{DynamicResource Loc.CardPresets}" Margin="0,24,0,4" />
                        <TextBlock Text="{DynamicResource Loc.CardPresetsHint}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Command="{Binding SavePresetCommand}" Content="{DynamicResource Loc.CardPresetSave}"
                                    Padding="12,6" Margin="8,0,0,0" />
                            <TextBox Style="{StaticResource Field}" Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                                     AutomationProperties.Name="{DynamicResource Loc.CardPresetName}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding SavedPresets}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Background="{DynamicResource SubtleFillHoverBrush}" Margin="0,0,0,4">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="12" Content="&#xE74D;"
                                                    Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    ToolTip="{DynamicResource Loc.CardPresetDelete}" AutomationProperties.Name="{DynamicResource Loc.CardPresetDelete}" />
                                            <Button Style="{StaticResource LinkButton}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="12,0,0,0"
                                                    VerticalAlignment="Center" HorizontalAlignment="Left" Content="{Binding Name}"
                                                    Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource LinkButton}" Command="{Binding ResetCommand}" Content="{DynamicResource Loc.CardReset}" Margin="0,14,0,8"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
