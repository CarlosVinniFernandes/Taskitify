<Window x:Class="Taskitify.Views.LyricCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Taskitify.Views"
        Title="Lyrics Studio"
        Width="1100" Height="800" MinWidth="880" MinHeight="600" WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/Taskitify.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <local:StudioColumnCountConverter x:Key="StudioColumnCount" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
        <Style TargetType="Slider" BasedOn="{StaticResource SettingsSlider}" />

        <Style x:Key="Group" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <DataTemplate x:Key="FontChip">
            <TextBlock Text="{Binding Label}" FontFamily="{Binding Typeface.FontFamily}"
                       FontWeight="{Binding Typeface.Weight}" FontStyle="{Binding Typeface.Style}"
                       FontStretch="{Binding Typeface.Stretch}" />
        </DataTemplate>

        <DataTemplate x:Key="AlignmentChip">
            <StackPanel Orientation="Horizontal">
                <Path x:Name="Diagram" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                      Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M8,1 L10,6 L15,8 L10,10 L8,15 L6,10 L1,8 L6,6 Z" />
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Value}" Value="Left">
                    <Setter TargetName="Diagram" Property="Data" Value="M1,3 H15 M1,8 H10 M1,13 H13" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Value}" Value="Center">
                    <Setter TargetName="Diagram" Property="Data" Value="M1,3 H15 M4,8 H12 M2.5,13 H13.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Value}" Value="Right">
                    <Setter TargetName="Diagram" Property="Data" Value="M1,3 H15 M6,8 H15 M3,13 H15" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Choice chip (format, font, alignment, signature), accent outline when chosen. -->
        <Style x:Key="Chip" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="16" Padding="9,4" Background="{DynamicResource SubtleFillHoverBrush}"
                                BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bg" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bg" Property="Padding" Value="8,3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style gallery: the style drawn with the chosen lines, and its name. -->
        <Style x:Key="StyleTile" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,11" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel x:Name="Tile">
                            <Grid Height="{Binding ActualWidth, ElementName=Tile}">
                                <Border CornerRadius="9" Background="{DynamicResource SubtleFillHoverBrush}" />
                                <Border CornerRadius="7" Margin="3">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Border x:Name="Ring" CornerRadius="9" BorderThickness="2" BorderBrush="Transparent" />
                                <Border x:Name="Check" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0" Visibility="Collapsed">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock x:Name="Name" Text="{Binding Label}" FontSize="11" Margin="1,3,1,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
                                <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwatchItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="ToolTip" Value="{Binding Label}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Width="32" Height="32">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" Opacity="0" />
                            <Ellipse Margin="4" Fill="{Binding Brush}" Stroke="{DynamicResource PopupBorderBrush}" StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Choices" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="T" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="StudioToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" MinHeight="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border x:Name="Track" Grid.Column="1" Width="36" Height="18" CornerRadius="9"
                                    BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1">
                                <Ellipse x:Name="Knob" Width="10" Height="10" HorizontalAlignment="Left" Margin="3,0"
                                         Fill="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StudioSection" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30*" MinWidth="264" />
            <ColumnDefinition Width="40*" MinWidth="260" />
            <ColumnDefinition Width="30*" MinWidth="264" />
        </Grid.ColumnDefinitions>

        <Grid Margin="14,12,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="7*" />
            </Grid.RowDefinitions>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,7">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Counter}" FontSize="12" Margin="8,0,0,0"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Command="{Binding ClearCommand}"
                            Content="{DynamicResource Loc.CardClear}" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Loc.CardTabLines}" FontWeight="SemiBold"
                               ToolTip="{DynamicResource Loc.CardLinesHint}" />
                </DockPanel>
            <Border Background="Transparent">
                <Grid>
                    <ScrollViewer x:Name="LinesScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,3,0">
                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton IsChecked="{Binding IsSelected}" Cursor="Hand" Margin="0,1" AutomationProperties.Name="{Binding Text}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Bg" CornerRadius="6" Padding="7,6" Background="{DynamicResource SubtleFillBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Top">
                                                            <Border x:Name="Circle" CornerRadius="3" BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1" />
                                                            <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                                        </Grid>
                                                        <TextBlock x:Name="Text" Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="11" Margin="5,1,0,0"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Top" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}" />
                                                        <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}" />
                                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="Bg" Property="BorderThickness" Value="1,0,0,0" />
                                                        <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                        <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
                                                        <Setter TargetName="Circle" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{DynamicResource Loc.CardNoLyrics}" TextAlignment="Center" VerticalAlignment="Center" Margin="20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLines}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            </DockPanel>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource PopupBorderBrush}" Margin="0,11,0,9" />

            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Loc.CardTabCustomize}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ScrollViewer x:Name="CustomizeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,5,0">
                        <StackPanel Visibility="{Binding HasStyleFields, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding StyleFields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Hint}" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Delay=150}" MaxLength="120"
                                                     AutomationProperties.Name="{Binding Label}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource Field}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasChoices}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <ComboBox Style="{StaticResource SettingsComboBox}" ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}"
                                                      MinWidth="0" AutomationProperties.Name="{Binding Label}"
                                                      Visibility="{Binding HasChoices, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Group}">
                                    <Setter Property="Text" Value="{DynamicResource Loc.CardColor}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStyle.Style}" Value="Retro">
                                            <Setter Property="Text" Value="{DynamicResource Loc.StudioDesktopColor}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListBox Style="{StaticResource Choices}" ItemContainerStyle="{StaticResource SwatchItem}" ItemsSource="{Binding Swatches}"
                                 SelectedItem="{Binding SelectedSwatch}" AutomationProperties.Name="{DynamicResource Loc.CardColor}" />
                        <DockPanel Margin="0,4,0,0">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource Field}" Width="86" FontFamily="Consolas"
                                     Text="{Binding CustomColor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Loc.CardCustomColor}" />
                            <TextBlock Text="{DynamicResource Loc.CardCustomColor}" VerticalAlignment="Center" FontSize="13"
                                       TextWrapping="Wrap" Margin="0,0,8,0" />
                        </DockPanel>
                        <StackPanel Visibility="{Binding HasImageOptions, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Group}" Text="{DynamicResource Loc.StudioImage}" />
                            <ListBox Style="{StaticResource Choices}" ItemContainerStyle="{StaticResource Chip}" ItemsSource="{Binding Images}"
                                     SelectedItem="{Binding SelectedImage}" AutomationProperties.Name="{DynamicResource Loc.StudioImage}" />
                            <Button Style="{StaticResource LinkButton}" Command="{Binding ChoosePhotoCommand}"
                                    Content="{DynamicResource Loc.StudioChoosePhoto}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Loc.StudioTypographyAndMark}" FontWeight="SemiBold" Margin="0,16,0,8" />
                        <StackPanel Visibility="{Binding CanChooseTypeface, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Group}" Text="{DynamicResource Loc.CardFont}" Margin="0,0,0,6" />
                            <ListBox Style="{StaticResource Choices}" ItemContainerStyle="{StaticResource Chip}" ItemsSource="{Binding Fonts}"
                                     ItemTemplate="{StaticResource FontChip}" SelectedItem="{Binding SelectedFont}"
                                     AutomationProperties.Name="{DynamicResource Loc.CardFont}" />
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="{DynamicResource Loc.CardFontSize}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding FontPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <Slider Minimum="60" Maximum="150" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding FontPercent}" Margin="0,6,0,0" AutomationProperties.Name="{DynamicResource Loc.CardFontSize}" />

                        <TextBlock Style="{StaticResource Group}" Text="{DynamicResource Loc.CardAlign}" />
                        <ListBox Style="{StaticResource Choices}" ItemContainerStyle="{StaticResource Chip}" ItemsSource="{Binding Aligns}"
                                 ItemTemplate="{StaticResource AlignmentChip}" SelectedItem="{Binding SelectedAlign}"
                                 AutomationProperties.Name="{DynamicResource Loc.CardAlign}" />

                        <TextBlock Style="{StaticResource Group}" Text="{DynamicResource Loc.CardMark}" />
                        <ListBox Style="{StaticResource Choices}" ItemContainerStyle="{StaticResource Chip}" ItemsSource="{Binding Marks}"
                                 SelectedItem="{Binding SelectedMark}" AutomationProperties.Name="{DynamicResource Loc.CardMark}" />
                        <CheckBox Style="{StaticResource StudioToggle}" IsChecked="{Binding ShowCover}" Margin="0,8,0,0"
                                  Visibility="{Binding CanShowCoverToggle, Converter={StaticResource BoolToVisibility}}"
                                  Content="{DynamicResource Loc.CardShowCover}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <CheckBox Style="{StaticResource StudioToggle}" IsChecked="{Binding ShowTimestamp}" Margin="0,4,0,0" IsEnabled="{Binding CanShowTimestamp}"
                                  Content="{DynamicResource Loc.CardShowTimestamp}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Expander Style="{StaticResource StudioSection}" Header="{DynamicResource Loc.CardPresets}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc.CardPresetsHint}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Command="{Binding SavePresetCommand}" Content="{DynamicResource Loc.CardPresetSave}"
                                            Padding="12,6" Margin="8,0,0,0" />
                                    <TextBox Style="{StaticResource Field}" Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                                             AutomationProperties.Name="{DynamicResource Loc.CardPresetName}" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding SavedPresets}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Background="{DynamicResource SubtleFillHoverBrush}" Margin="0,0,0,4">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="12" Content="&#xE74D;"
                                                            Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                            ToolTip="{DynamicResource Loc.CardPresetDelete}" AutomationProperties.Name="{DynamicResource Loc.CardPresetDelete}" />
                                                    <Button Style="{StaticResource FlatButton}" FontSize="12" Padding="7,3" Margin="3"
                                                            VerticalAlignment="Center" HorizontalAlignment="Left" Content="{Binding Name}"
                                                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                        <Button Style="{StaticResource FlatButton}" Command="{Binding ResetCommand}" Content="{DynamicResource Loc.CardReset}"
                                Padding="8,5" FontSize="12" Margin="0,12,0,5" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- Preview: the exported card itself, scaled to fit; nothing of the window is in it. -->
        <Border Grid.Column="1" Background="{DynamicResource ControlBackgroundBrush}">
            <Grid>
                <!-- The shadow is its own layer: an effect over the image would re-rasterise it unsmoothed. -->
                <Viewbox Margin="22,64" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}">
                        <Border Background="Black">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="70" ShadowDepth="12" Direction="270" Opacity="0.45" Color="Black" />
                            </Border.Effect>
                        </Border>
                        <Image Source="{Binding Preview}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Viewbox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8,0,8,10">
                    <TextBlock Text="{Binding PreviewDimensions}" FontSize="12" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Credit}" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" Visibility="{Binding Credit, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Column="2" Margin="14,12,14,12">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="{DynamicResource Loc.CardTabStyle}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ListBox Style="{StaticResource Choices}" ItemContainerStyle="{StaticResource Chip}" ItemsSource="{Binding Formats}"
                         SelectedItem="{Binding SelectedFormat}" AutomationProperties.Name="{DynamicResource Loc.CardFormat}" />
                <Grid Margin="0,2,0,0">
                    <TextBox x:Name="StyleSearchBox" Style="{StaticResource Field}" Text="{Binding StyleSearch, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{DynamicResource Loc.StudioSearch}" />
                    <TextBlock Text="{DynamicResource Loc.StudioSearch}" FontSize="12" Margin="9,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=StyleSearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=StyleSearchBox}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
            <!-- Export -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <!-- Share as a link (experimental): optional dedication, then the link is copied. -->
                <Border Visibility="{Binding IsSharing, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10" Padding="12,10,12,12"
                        CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource PopupBorderBrush}" Background="{DynamicResource SubtleFillBrush}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.CardShareTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Loc.CardShareHint}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc.CardShareFrom}" Style="{StaticResource Hint}" Margin="0,0,0,3" />
                                <TextBox Style="{StaticResource Field}" Text="{Binding ShareFrom, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                                         AutomationProperties.Name="{DynamicResource Loc.CardShareFrom}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Loc.CardShareTo}" Style="{StaticResource Hint}" Margin="0,0,0,3" />
                                <TextBox Style="{StaticResource Field}" Text="{Binding ShareTo, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                                         AutomationProperties.Name="{DynamicResource Loc.CardShareTo}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{DynamicResource Loc.CardShareMessage}" Style="{StaticResource Hint}" Margin="0,8,0,3" />
                        <TextBox Style="{StaticResource Field}" Text="{Binding ShareMessage, UpdateSourceTrigger=PropertyChanged}" MaxLength="280"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="54" VerticalContentAlignment="Top"
                                 AutomationProperties.Name="{DynamicResource Loc.CardShareMessage}" />
                        <CheckBox Style="{StaticResource StudioToggle}" IsChecked="{Binding ShareSurprise}" Margin="0,8,0,0"
                                  Content="{DynamicResource Loc.CardShareSurprise}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Loc.CardSharePrivacy}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,8" />
                        <Button Style="{StaticResource AccentButton}" Command="{Binding CopyLinkCommand}" Padding="8,8" FontSize="12" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Loc.CardShareCopy}" />
                            </StackPanel>
                        </Button>
                        <TextBox Text="{Binding ShareLink, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Field}" Margin="0,8,0,0" FontSize="11"
                                 Visibility="{Binding ShareLink, Converter={StaticResource NullToCollapsed}}"
                                 AutomationProperties.Name="{DynamicResource Loc.CardShareTitle}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,0,0,5" MinHeight="16" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource FlatButton}" Command="{Binding SaveCommand}" Padding="8,8" FontSize="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Loc.CardSave}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource AccentButton}" Command="{Binding CopyCommand}" Padding="8,8" FontSize="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Loc.CardCopy}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Button Style="{StaticResource FlatButton}" Command="{Binding ToggleShareCommand}" Padding="8,7" FontSize="12" Margin="0,8,0,0"
                        Visibility="{Binding ShareEnabled, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Loc.CardShareLink}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <ScrollViewer x:Name="GalleryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,7,0">
                    <TextBlock Text="{DynamicResource Loc.StudioNoResults}" Margin="0,10,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasStyleResults}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListBox x:Name="StudioGallery" Style="{StaticResource Choices}" ItemContainerStyle="{StaticResource StyleTile}"
                             ItemsSource="{Binding Gallery}" SelectedItem="{Binding SelectedStyle}"
                             AutomationProperties.Name="{DynamicResource Loc.CardStyle}" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource StudioColumnCount}}" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <StackPanel>
                                                        <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                          Content="{TemplateBinding Content}" />
                                                        <ItemsPresenter />
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                                </GroupStyle.Panel>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,9,0,5">
                                            <Border BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,5" />
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
