<Window x:Class="Taskitify.Views.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taskitify — mini player"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="384"
        SizeToContent="Height"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!-- 12px transparent margin leaves room for the shadow. -->
    <Grid x:Name="Chrome" Margin="12">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="ChromeOffset" />
        </Grid.RenderTransform>

        <!-- Shadow lives on its own layer so the content keeps ClearType-sharp text. -->
        <Border CornerRadius="10" Background="{DynamicResource PopupBackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.35" Color="Black" />
            </Border.Effect>
        </Border>

        <Border x:Name="ContentCard" CornerRadius="10" Background="{DynamicResource PopupBackgroundBrush}"
                BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" Padding="16,16,16,12">
            <StackPanel>
                <!-- Header: cover, title, artist -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="64" Height="64">
                        <Border CornerRadius="6" Background="{DynamicResource SubtleFillHoverBrush}">
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource UiDisplayFont}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Title}" />
                        <TextBlock Text="{Binding Artist}" FontSize="13" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,4">
                    <Button Style="{StaticResource IconButton}" Command="{Binding PreviousCommand}" Content="&#xE892;" ToolTip="{DynamicResource Loc.Previous}" />
                    <Button Style="{StaticResource PlayButton}" Command="{Binding PlayPauseCommand}" Margin="16,0" x:Name="PlayPauseButton"
                            ToolTip="{DynamicResource Loc.PlayPause}">
                        <TextBlock x:Name="PlayPauseGlyph" Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                   Foreground="{DynamicResource WindowBackgroundBrush}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding NextCommand}" Content="&#xE893;" ToolTip="{DynamicResource Loc.Next}" />
                </StackPanel>

                <Grid Margin="0,8,0,8">
                <!-- Lyrics: a fixed viewport; the list is translated so the current line sits in the middle.
                     A transparent background lets the wheel scroll it anywhere, between lines too. -->
                <Grid x:Name="LyricsViewport" Height="168" ClipToBounds="True" Background="Transparent">
                    <Grid.OpacityMask>
                        <!-- Absolute: relative mapping would use the bounds of the whole (translated) list. -->
                        <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="0,168">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="0.18" Color="Black" />
                            <GradientStop Offset="0.82" Color="Black" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </LinearGradientBrush>
                    </Grid.OpacityMask>

                    <!-- A Canvas measures its child with infinite height, so no layout clip cuts the list. -->
                    <Canvas>
                    <ItemsControl x:Name="LyricsList" ItemsSource="{Binding Lines}"
                                  Width="{Binding ActualWidth, ElementName=LyricsViewport}">
                        <ItemsControl.RenderTransform>
                            <TranslateTransform x:Name="LyricsOffset" />
                        </ItemsControl.RenderTransform>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextAlignment="Center"
                                           FontSize="14" Padding="4,5" Cursor="Hand"
                                           MouseLeftButtonUp="OnLyricLineClicked">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <!-- In the style (not a local value) so the triggers can override it. -->
                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                    <Setter Property="Opacity" Value="0.75" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Canvas>

                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center"
                               VerticalAlignment="Center" Margin="12,0" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" x:Name="StatusText" />
                </Grid>
                <!-- Shown once the user scrolls the lyrics; outside the viewport so its fade does not dim it. -->
                <Button x:Name="ResyncButton" Style="{StaticResource FlatButton}" Visibility="Collapsed" Click="OnResync"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2" Padding="12,4" FontSize="12"
                        Background="{DynamicResource WindowBackgroundBrush}" Content="{DynamicResource Loc.LyricsResync}" />
                </Grid>

                <!-- Progress -->
                <Slider x:Name="Progress" Style="{StaticResource ProgressSlider}" Minimum="0"
                        Maximum="{Binding DurationSeconds, Mode=OneWay}" IsEnabled="{Binding CanSeek}" />
                <Grid Margin="0,2,0,0">
                    <TextBlock Text="{Binding PositionText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding DurationText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
