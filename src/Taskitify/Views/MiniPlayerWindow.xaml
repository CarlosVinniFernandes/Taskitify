<Window x:Class="Taskitify.Views.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Taskitify.Views"
        Title="Taskitify — mini player"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Width="384"
        SizeToContent="Height"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Every transport button fits the narrowest card (6 × 36 + play). -->
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
        </Style>
        <!-- Shuffle, repeat and an open volume turn Spotify green, as on the taskbar. -->
        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Foreground" Value="#FF1ED760" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- "Solid" controls: a large play glyph without its circle. -->
        <Style x:Key="SolidPlayButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
        </Style>
    </Window.Resources>

    <!-- 12px transparent margin leaves room for the shadow. -->
    <Grid x:Name="Chrome" Margin="12">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="ChromeOffset" />
        </Grid.RenderTransform>

        <!-- Shadow lives on its own layer so the content keeps ClearType-sharp text. -->
        <Border x:Name="ShadowLayer" CornerRadius="12" Background="{DynamicResource PopupBackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.35" Color="Black" />
            </Border.Effect>
        </Border>

        <!-- Floating (not that minimal): clicks pass through, marked by the crossed-out pointer;
             the corner grip resizes it. Both only while pinned. -->
        <Border x:Name="ContentCard" CornerRadius="12" Background="{DynamicResource PopupBackgroundBrush}"
                BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" Padding="16,16,16,10" ClipToBounds="True">
            <!-- The parts below are placed by the layout (vertical or cinema wide) in code: one set, two arrangements. -->
            <Grid x:Name="LayoutRoot">

                <!-- Song: cover, title, artist and the secondary actions (like, share). -->
                <Grid x:Name="HeaderPart" Visibility="{Binding ShowHeaderPart, Converter={StaticResource BoolToVisibility}}" TextOptions.TextFormattingMode="Ideal">
                    <Grid x:Name="CoverPart" Width="64" Height="64" Margin="0,0,14,0" VerticalAlignment="Top"
                          Visibility="{Binding ShowCover, Converter={StaticResource BoolToVisibility}}">
                        <Border x:Name="CoverPlaceholder" CornerRadius="8" Background="{DynamicResource SubtleFillHoverBrush}">
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="CoverImage" CornerRadius="8">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="TitlePart" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="{Binding Title}" FontFamily="{Binding TitleFont}" FontSize="{Binding TitleFontSize}" FontWeight="{Binding TitleWeight}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Title}" Visibility="{Binding ShowTitle, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock x:Name="ArtistText" Text="{Binding Artist}" FontSize="13.5" Margin="0,3,0,0" FontFamily="{Binding TitleFont}" FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Artist}" Visibility="{Binding ShowArtist, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel x:Name="ActionsPart" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,-6,0">
                        <Button Style="{StaticResource IconButton}" Width="34" Height="34" Command="{Binding Like.ClickCommand}"
                                ToolTip="{Binding Like.Tip}" AutomationProperties.Name="{Binding Like.Tip}"
                                Visibility="{Binding ShowLike, Converter={StaticResource BoolToVisibility}}">
                            <local:LikeGlyph x:Name="LikeIcon" IsLiked="{Binding Like.IsLiked}" Stroke="{DynamicResource TextPrimaryBrush}" Width="18" Height="18" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="15" Command="{Binding ShareCommand}" Content="&#xE72D;"
                                ToolTip="{DynamicResource Loc.LyricCardOpen}" AutomationProperties.Name="{DynamicResource Loc.LyricCardOpen}" />
                        <!-- Karaoke: whether the song has real word/syllable timing, and showing it or not. -->
                        <Button x:Name="KaraokeButton" Width="34" Height="34" Command="{Binding KaraokeCommand}"
                                ToolTip="{Binding KaraokeTip}" AutomationProperties.Name="{Binding KaraokeTip}">
                            <Grid Width="20" Height="20">
                                <TextBlock x:Name="KaraokeGlyph" Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <!-- Backing vocals or a duet: a small mark. -->
                                <Ellipse x:Name="KaraokeRichMark" Width="5" Height="5" Fill="#FF1ED760" HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Visibility="{Binding KaraokeRich, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding KaraokeState}" Value="Hidden">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding KaraokeState}" Value="Unavailable">
                                            <Setter Property="Opacity" Value="0.35" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding KaraokeState}" Value="Search">
                                            <Setter Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding KaraokeState}" Value="Active">
                                            <Setter Property="Foreground" Value="#FF1ED760" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Lyrics: a fixed viewport; the list is translated so the current line sits in the middle.
                     A transparent background lets the wheel scroll it anywhere, between lines too. -->
                <Grid x:Name="LyricsPart" Margin="0,10,0,6" TextOptions.TextFormattingMode="Ideal">
                    <Grid x:Name="LyricsViewport" Height="176" ClipToBounds="True" Background="Transparent">
                        <Grid.OpacityMask>
                            <!-- Absolute: relative mapping would use the bounds of the whole (translated) list. -->
                            <LinearGradientBrush x:Name="LyricsFade" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,176">
                                <GradientStop Offset="0" Color="Transparent" />
                                <GradientStop Offset="0.16" Color="Black" />
                                <GradientStop Offset="0.84" Color="Black" />
                                <GradientStop Offset="1" Color="Transparent" />
                            </LinearGradientBrush>
                        </Grid.OpacityMask>

                        <!-- A Canvas measures its child with infinite height, so no layout clip cuts the list. -->
                        <Canvas>
                            <StackPanel Width="{Binding ActualWidth, ElementName=LyricsViewport}">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="LyricsOffset" />
                                </StackPanel.RenderTransform>
                                <ItemsControl x:Name="LyricsList" ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- The emphasis (opacity, scale, weight) comes from the highlight style; scaling is a render
                                                 transform, so a growing line never moves the others or resizes the window. -->
                                            <StackPanel>
                                            <local:LyricMotionText x:Name="Main" Text="{Binding DisplayText}" TextWrapping="Wrap" Cursor="Hand"
                                                       Interlude="{Binding ShowsDots}" InterludeActive="{Binding IsCurrent}"
                                                       InterludeStart="{Binding Time}" InterludeEnd="{Binding End}"
                                                       PositionClock="{Binding DataContext.PositionClock, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       Playing="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       LineHeight="{Binding DataContext.MotionLineHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       Expressive="{Binding DataContext.ExpressiveMotion, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       TransitionMilliseconds="{Binding MotionMilliseconds}"
                                                       TextAlignment="{Binding Alignment}"
                                                       FontFamily="{Binding DataContext.LyricsFont, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       FontSize="{Binding DataContext.LyricsFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       Padding="{Binding DataContext.LyricsLinePadding, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       RenderTransformOrigin="{Binding ScaleOrigin}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" TargetOpacity="{Binding Emphasis}"
                                                       FontWeight="{Binding Weight}" Effect="{Binding Soften}" TargetScale="{Binding Scale}"
                                                       MouseLeftButtonUp="OnLyricLineClicked" />
                                            <!-- Backing vocals (karaoke): smaller, a little fainter, under the line, filled on their own timing. -->
                                            <local:LyricMotionText x:Name="Backing" Text="{Binding BackgroundText}" TextWrapping="Wrap"
                                                       Visibility="{Binding BackgroundText, Converter={StaticResource NullToCollapsed}}"
                                                       TextAlignment="{Binding Alignment}" Margin="0,-6,0,2"
                                                       FontFamily="{Binding DataContext.LyricsFont, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       FontSize="{Binding DataContext.BackingFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       Padding="{Binding DataContext.LyricsLinePadding, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       RenderTransformOrigin="{Binding ScaleOrigin}" Opacity="0.75"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" TargetOpacity="{Binding BackingEmphasis}"
                                                       FontWeight="SemiBold" Effect="{Binding Soften}" TargetScale="{Binding Scale}"
                                                       TransitionMilliseconds="{Binding MotionMilliseconds}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="CreditText" Text="{Binding Credit}" FontSize="14" FontWeight="SemiBold" Margin="4,16,4,4"
                                           TextWrapping="Wrap" TextAlignment="{Binding LyricsTextAlignment}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Visibility="{Binding Credit, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </Canvas>

                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center"
                                   VerticalAlignment="Center" Margin="12,0" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" x:Name="StatusText" />
                    </Grid>
                    <!-- Shown once the user scrolls the lyrics; outside the viewport so its fade does not dim it. -->
                    <Button x:Name="ResyncButton" Style="{StaticResource FlatButton}" Visibility="Collapsed" Click="OnResync"
                            VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2" Padding="12,4" FontSize="12"
                            Background="{DynamicResource WindowBackgroundBrush}" Content="{DynamicResource Loc.LyricsResync}" />
                </Grid>

                <!-- Progress -->
                <StackPanel x:Name="ProgressPart" Margin="0,2,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}">
                    <local:SeekBar x:Name="Progress" IsEnabled="{Binding CanSeek}"
                                   AutomationProperties.Name="{DynamicResource Loc.Seek}" />
                    <Grid Margin="0,2,0,0">
                        <TextBlock Text="{Binding PositionText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding DurationText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <!-- Controls, under the progress, nearest the taskbar. Play always sits in the middle whatever else is
                     chosen: previous and shuffle to its left, next and repeat to its right, the volume at the edge. -->
                <Grid x:Name="ControlsPart" Margin="0,6,0,2" Visibility="{Binding ShowTransport, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ModeButton}" Command="{Binding ShuffleCommand}" Content="&#xE8B1;" Tag="{Binding IsShuffleActive}"
                                AutomationProperties.Name="{DynamicResource Loc.Shuffle}" ToolTip="{DynamicResource Loc.Shuffle}" Visibility="{Binding ShowShuffle, Converter={StaticResource BoolToVisibility}}" />
                        <Button x:Name="PreviousButton" Style="{StaticResource RowButton}" Command="{Binding PreviousCommand}" Content="&#xE892;" AutomationProperties.Name="{DynamicResource Loc.Previous}" ToolTip="{DynamicResource Loc.Previous}"
                                Visibility="{Binding ShowPrevious, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource PlayButton}" Command="{Binding PlayPauseCommand}" Margin="8,0" x:Name="PlayPauseButton"
                            AutomationProperties.Name="{DynamicResource Loc.PlayPause}" ToolTip="{DynamicResource Loc.PlayPause}" Visibility="{Binding ShowPlayPause, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock x:Name="PlayPauseGlyph" Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                   Foreground="{DynamicResource WindowBackgroundBrush}" />
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="NextButton" Style="{StaticResource RowButton}" Command="{Binding NextCommand}" Content="&#xE893;" AutomationProperties.Name="{DynamicResource Loc.Next}" ToolTip="{DynamicResource Loc.Next}"
                                Visibility="{Binding ShowNext, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource ModeButton}" Command="{Binding RepeatCommand}" Content="{Binding RepeatGlyph}" Tag="{Binding IsRepeatActive}"
                                AutomationProperties.Name="{DynamicResource Loc.Repeat}" ToolTip="{DynamicResource Loc.Repeat}" Visibility="{Binding ShowRepeat, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <Button x:Name="VolumeButton" Grid.Column="2" Style="{StaticResource ModeButton}" Command="{Binding Volume.ToggleOpenCommand}"
                            Content="{Binding Volume.Glyph}" HorizontalAlignment="Right" Tag="{Binding Volume.IsOpen}" ToolTip="{Binding Volume.Tip}"
                            Visibility="{Binding ShowVolume, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolumeButton}" Placement="Custom"
                       StaysOpen="True" AllowsTransparency="True" IsOpen="{Binding Volume.IsOpen, Mode=TwoWay}">
                    <!-- Include the flyout's shadow margin in its placement size. -->
                    <Grid>
                        <Border Style="{StaticResource FlyoutCard}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Command="{Binding Volume.MuteCommand}" Content="{Binding Volume.Glyph}"
                                        ToolTip="{DynamicResource Loc.MuteUnmute}" AutomationProperties.Name="{DynamicResource Loc.MuteUnmute}" />
                                <Slider x:Name="VolumeSlider" Style="{StaticResource SettingsSlider}" Width="170" Minimum="0" Maximum="100" Margin="6,0,10,0"
                                        VerticalAlignment="Center" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10"
                                        Value="{Binding Volume.Percent, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Loc.Volume}" />
                                <TextBlock Text="{Binding Volume.Percent, StringFormat={}{0:0}}" Width="26" TextAlignment="Right"
                                           VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Popup>

                <!-- Unlike needs a confirmation, so a stray click does not drop a song from Liked Songs. -->
                <Border x:Name="ConfirmPart" Margin="0,8,0,4" Padding="12,8" CornerRadius="6" Background="{DynamicResource SubtleFillHoverBrush}"
                        Visibility="{Binding Like.IsConfirming, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Loc.UnlikeQuestion}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource FlatButton}" Command="{Binding Like.CancelCommand}" Content="{DynamicResource Loc.Cancel}"
                                    Padding="10,4" Margin="0,0,6,0" FontSize="12" />
                            <Button Style="{StaticResource DangerButton}" Command="{Binding Like.ConfirmCommand}" Content="{DynamicResource Loc.UnlikeConfirm}"
                                    Padding="10,4" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <!-- The window's own buttons, over the top right corner while the pointer is on the player:
             nothing moves or shrinks for them. Popup: float, Minimal Mode, settings. Floating: its own. -->
        <Border x:Name="PinnedToolbar" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,6,0" Padding="2"
                CornerRadius="9" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                BorderThickness="1" Visibility="Collapsed" Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.3" Color="Black" />
            </Border.Effect>
            <Border.Resources>
                <Style x:Key="PinnedTool" TargetType="Button" BasedOn="{StaticResource IconButton}">
                    <Setter Property="Width" Value="26" />
                    <Setter Property="Height" Value="26" />
                    <Setter Property="FontSize" Value="12" />
                </Style>
            </Border.Resources>
            <StackPanel Orientation="Horizontal">
            <Button x:Name="PopupKeepOpen" Style="{StaticResource PinnedTool}" Content="&#xE718;"
                    ToolTip="{DynamicResource Loc.KeepOpen}" AutomationProperties.Name="{DynamicResource Loc.KeepOpen}" />
            <Button x:Name="PopupFloat" Style="{StaticResource PinnedTool}" Content="&#xE8A7;"
                    ToolTip="{DynamicResource Loc.FloatPlayer}" AutomationProperties.Name="{DynamicResource Loc.FloatPlayer}" />
            <Button x:Name="PinnedSwitch" Style="{StaticResource PinnedTool}" Content="&#xE8D6;"
                    ToolTip="{DynamicResource Loc.SwitchToMinimal}" AutomationProperties.Name="{DynamicResource Loc.SwitchToMinimal}" />
            <!-- A small A and a large A: which is which shows at a glance. -->
            <Button x:Name="LyricsSmaller" Style="{StaticResource PinnedTool}"
                    ToolTip="{DynamicResource Loc.LyricsSmaller}" AutomationProperties.Name="{DynamicResource Loc.LyricsSmaller}">
                <TextBlock FontFamily="{StaticResource UiFont}" FontWeight="SemiBold" VerticalAlignment="Center"><Run Text="A" FontSize="10" /><Run Text="−" FontSize="10" /></TextBlock>
            </Button>
            <Button x:Name="LyricsBigger" Style="{StaticResource PinnedTool}"
                    ToolTip="{DynamicResource Loc.LyricsBigger}" AutomationProperties.Name="{DynamicResource Loc.LyricsBigger}">
                <TextBlock FontFamily="{StaticResource UiFont}" FontWeight="SemiBold" VerticalAlignment="Center"><Run Text="A" FontSize="16" /><Run Text="+" FontSize="11" /></TextBlock>
            </Button>
            <Button x:Name="PinnedMaximize" Style="{StaticResource PinnedTool}" Content="&#xE922;"
                    ToolTip="{DynamicResource Loc.MaximizeWindow}" AutomationProperties.Name="{DynamicResource Loc.MaximizeWindow}" />
            <Button x:Name="PinnedFullScreen" Style="{StaticResource PinnedTool}" Content="&#xE740;"
                    ToolTip="{DynamicResource Loc.FullScreen}" AutomationProperties.Name="{DynamicResource Loc.FullScreen}" />
            <Button x:Name="PinnedSettings" Style="{StaticResource PinnedTool}" Content="&#xE713;"
                    ToolTip="{DynamicResource Loc.MiniPlayerSettings}" AutomationProperties.Name="{DynamicResource Loc.MiniPlayerSettings}" />
            <Button x:Name="PinnedClickThrough" Style="{StaticResource PinnedTool}"
                    ToolTip="{DynamicResource Loc.MinimalClickThroughTip}" AutomationProperties.Name="{DynamicResource Loc.MinimalClickThroughTip}">
                <Grid Width="16" Height="16">
                    <Path Data="M4,2 L4,12 L6.5,9.6 L8.6,13.8 L10.2,13 L8.2,8.9 L11.6,8.9 Z" Fill="{DynamicResource TextPrimaryBrush}" />
                    <Path Data="M2.5,14 L13.5,2.5" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Grid>
            </Button>
            <Button x:Name="PinnedLock" Style="{StaticResource PinnedTool}" Content="&#xE785;"
                    ToolTip="{DynamicResource Loc.MinimalLock}" AutomationProperties.Name="{DynamicResource Loc.MinimalLock}" />
            <Button x:Name="PinnedClose" Style="{StaticResource PinnedTool}" Content="&#xE711;"
                    ToolTip="{DynamicResource Loc.FloatingPlayerClose}" AutomationProperties.Name="{DynamicResource Loc.FloatingPlayerClose}" />
            </StackPanel>
        </Border>
        <!-- Full screen: the window buttons of any app (minimize, back to a window, close). -->
        <StackPanel x:Name="CaptionButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
            <StackPanel.Resources>
                <Style x:Key="Caption" TargetType="Button">
                    <Setter Property="Width" Value="46" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Back" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Back" Property="Background" Value="#26FFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Back" Property="Background" Value="#3DFFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>
            <Button x:Name="CaptionMinimize" Style="{StaticResource Caption}" Content="&#xE921;"
                    ToolTip="{DynamicResource Loc.WindowMinimize}" AutomationProperties.Name="{DynamicResource Loc.WindowMinimize}" />
            <Button x:Name="CaptionRestore" Style="{StaticResource Caption}" Content="&#xE923;"
                    ToolTip="{DynamicResource Loc.RestoreSize}" AutomationProperties.Name="{DynamicResource Loc.RestoreSize}" />
            <Button x:Name="CaptionClose" Content="&#xE8BB;"
                    ToolTip="{DynamicResource Loc.FloatingPlayerClose}" AutomationProperties.Name="{DynamicResource Loc.FloatingPlayerClose}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Caption}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Back" Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Back" Property="Background" Value="#C42B1C" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Back" Property="Background" Value="#B22A1B" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <Grid x:Name="PinnedMark" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,8"
              Opacity="0.6" IsHitTestVisible="False" Visibility="Collapsed">
            <Path Data="M5,3 L5,15 L8,12 L10.5,17 L12.5,16 L10,11 L14,11 Z" Fill="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Path Data="M3,17 L17,3" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <Grid x:Name="PinnedGrip" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
              Background="Transparent" Cursor="SizeNWSE" Opacity="0.6" Visibility="Collapsed" ToolTip="{DynamicResource Loc.PlayerResize}">
            <Path Data="M16,4 L4,16 M16,9 L9,16 M16,14 L14,16" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
