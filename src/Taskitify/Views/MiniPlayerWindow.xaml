<Window x:Class="Taskitify.Views.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Taskitify.Views"
        Title="Taskitify — mini player"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="384"
        SizeToContent="Height"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!-- 12px transparent margin leaves room for the shadow. -->
    <Grid x:Name="Chrome" Margin="12">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="ChromeOffset" />
        </Grid.RenderTransform>

        <!-- Shadow lives on its own layer so the content keeps ClearType-sharp text. -->
        <Border CornerRadius="10" Background="{DynamicResource PopupBackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.35" Color="Black" />
            </Border.Effect>
        </Border>

        <Border x:Name="ContentCard" CornerRadius="10" Background="{DynamicResource PopupBackgroundBrush}"
                BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" Padding="16,16,16,12">
            <StackPanel>
                <!-- Header: cover, title, artist. Every element below is optional (Settings), like on the taskbar. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="64" Height="64" Margin="0,0,14,0" Visibility="{Binding ShowCover, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="6" Background="{DynamicResource SubtleFillHoverBrush}">
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource UiDisplayFont}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Title}" Visibility="{Binding ShowTitle, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Artist}" FontSize="13" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding ShowArtist, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <!-- Lyric card: always there, in the corner, so a layout without a header still has it. -->
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="15" VerticalAlignment="Top"
                            Margin="8,0,-6,0" Command="{Binding ShareCommand}" Content="&#xE72D;"
                            ToolTip="{DynamicResource Loc.LyricCardOpen}" AutomationProperties.Name="{DynamicResource Loc.LyricCardOpen}" />
                </Grid>

                <!-- Controls. Play always sits in the middle whatever else is chosen: previous and shuffle
                     to its left, next and repeat to its right, the heart and the volume at the edges. -->
                <Grid Margin="0,12,0,4" Visibility="{Binding ShowControls, Converter={StaticResource BoolToVisibility}}">
                    <Grid.Resources>
                        <!-- Shuffle, repeat, an open volume and a liked song turn Spotify green, as on the taskbar. -->
                        <!-- Every button fits the narrowest card (6 × 36 + play). -->
                        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Width" Value="36" />
                            <Setter Property="Height" Value="36" />
                        </Style>
                        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                    <Setter Property="Foreground" Value="#FF1ED760" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource ModeButton}" Command="{Binding Like.ClickCommand}" Content="{Binding Like.Glyph}" Tag="{Binding Like.IsLiked}"
                            HorizontalAlignment="Left" ToolTip="{Binding Like.Tip}" AutomationProperties.Name="{Binding Like.Tip}"
                            Visibility="{Binding ShowLike, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ModeButton}" Command="{Binding ShuffleCommand}" Content="&#xE8B1;" Tag="{Binding IsShuffleActive}"
                                ToolTip="{DynamicResource Loc.Shuffle}" Visibility="{Binding ShowShuffle, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource RowButton}" Command="{Binding PreviousCommand}" Content="&#xE892;" ToolTip="{DynamicResource Loc.Previous}"
                                Visibility="{Binding ShowPrevious, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource PlayButton}" Command="{Binding PlayPauseCommand}" Margin="8,0" x:Name="PlayPauseButton"
                            ToolTip="{DynamicResource Loc.PlayPause}" Visibility="{Binding ShowPlayPause, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock x:Name="PlayPauseGlyph" Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                   Foreground="{DynamicResource WindowBackgroundBrush}" />
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource RowButton}" Command="{Binding NextCommand}" Content="&#xE893;" ToolTip="{DynamicResource Loc.Next}"
                                Visibility="{Binding ShowNext, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource ModeButton}" Command="{Binding RepeatCommand}" Content="{Binding RepeatGlyph}" Tag="{Binding IsRepeatActive}"
                                ToolTip="{DynamicResource Loc.Repeat}" Visibility="{Binding ShowRepeat, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <Button x:Name="VolumeButton" Grid.Column="2" Style="{StaticResource ModeButton}" Command="{Binding Volume.ToggleOpenCommand}"
                            Content="{Binding Volume.Glyph}" HorizontalAlignment="Right" Tag="{Binding Volume.IsOpen}" ToolTip="{Binding Volume.Tip}"
                            Visibility="{Binding ShowVolume, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- Volume slider, opened by the volume button. Inline: a popup outside the card would count as a click outside. -->
                <Grid Margin="8,6,8,0" Visibility="{Binding Volume.IsOpen, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="14" Command="{Binding Volume.MuteCommand}"
                            Content="{Binding Volume.Glyph}" ToolTip="{DynamicResource Loc.MuteUnmute}" AutomationProperties.Name="{DynamicResource Loc.MuteUnmute}" />
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource SettingsSlider}" Minimum="0" Maximum="100" Margin="6,0,10,0"
                            VerticalAlignment="Center" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10"
                            Value="{Binding Volume.Percent, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Loc.Volume}" />
                    <TextBlock Grid.Column="2" Text="{Binding Volume.Percent, StringFormat={}{0:0}}" Width="26" TextAlignment="Right"
                               VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>

                <!-- Unlike needs a confirmation, so a stray click does not drop a song from Liked Songs. -->
                <Border Margin="0,8,0,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource SubtleFillHoverBrush}"
                        Visibility="{Binding Like.IsConfirming, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Loc.UnlikeQuestion}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource FlatButton}" Command="{Binding Like.CancelCommand}" Content="{DynamicResource Loc.Cancel}"
                                    Padding="10,4" Margin="0,0,6,0" FontSize="12" />
                            <Button Style="{StaticResource DangerButton}" Command="{Binding Like.ConfirmCommand}" Content="{DynamicResource Loc.UnlikeConfirm}"
                                    Padding="10,4" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,8,0,8">
                <!-- Lyrics: a fixed viewport; the list is translated so the current line sits in the middle.
                     A transparent background lets the wheel scroll it anywhere, between lines too. -->
                <Grid x:Name="LyricsViewport" Height="168" ClipToBounds="True" Background="Transparent">
                    <Grid.OpacityMask>
                        <!-- Absolute: relative mapping would use the bounds of the whole (translated) list. -->
                        <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="0,168">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="0.18" Color="Black" />
                            <GradientStop Offset="0.82" Color="Black" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </LinearGradientBrush>
                    </Grid.OpacityMask>

                    <!-- A Canvas measures its child with infinite height, so no layout clip cuts the list. -->
                    <Canvas>
                    <ItemsControl x:Name="LyricsList" ItemsSource="{Binding Lines}"
                                  Width="{Binding ActualWidth, ElementName=LyricsViewport}">
                        <ItemsControl.RenderTransform>
                            <TranslateTransform x:Name="LyricsOffset" />
                        </ItemsControl.RenderTransform>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextAlignment="Center"
                                           FontSize="14" Padding="4,5" Cursor="Hand"
                                           MouseLeftButtonUp="OnLyricLineClicked">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <!-- In the style (not a local value) so the triggers can override it. -->
                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                    <Setter Property="Opacity" Value="0.75" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Canvas>

                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center"
                               VerticalAlignment="Center" Margin="12,0" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" x:Name="StatusText" />
                </Grid>
                <!-- Shown once the user scrolls the lyrics; outside the viewport so its fade does not dim it. -->
                <Button x:Name="ResyncButton" Style="{StaticResource FlatButton}" Visibility="Collapsed" Click="OnResync"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2" Padding="12,4" FontSize="12"
                        Background="{DynamicResource WindowBackgroundBrush}" Content="{DynamicResource Loc.LyricsResync}" />
                </Grid>

                <!-- Progress -->
                <StackPanel Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}">
                    <local:SeekBar x:Name="Progress" IsEnabled="{Binding CanSeek}"
                                   AutomationProperties.Name="{DynamicResource Loc.Seek}" />
                    <Grid Margin="0,2,0,0">
                        <TextBlock Text="{Binding PositionText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding DurationText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
