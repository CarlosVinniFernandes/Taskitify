<UserControl x:Class="Taskitify.Views.MiniPlayerPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A replica of the mini player popup, laid out like it (header, controls, lyrics, progress).
         Every element but the lyrics is a toggle bound to a BarLayoutViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary Source="/Taskitify;component/Resources/PickerStyles.xaml" />
    </UserControl.Resources>

    <Border Width="300" CornerRadius="10" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="14,14,14,10"
            Background="{Binding PickerBackground}">
        <StackPanel>
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton Style="{StaticResource PickCover}" IsChecked="{Binding Elements.ShowCover}" Width="48" Height="48"
                              ToolTip="{DynamicResource Loc.Cover}" AutomationProperties.Name="{DynamicResource Loc.Cover}">
                    <Image Source="{Binding PreviewCover}" Stretch="UniformToFill" />
                </ToggleButton>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource PickMainText}" FontSize="14" FontWeight="SemiBold" IsChecked="{Binding Elements.ShowText}"
                                  HorizontalAlignment="Left" ToolTip="{Binding Elements.TextLabel}" AutomationProperties.Name="{Binding Elements.TextLabel}">
                        <TextBlock Text="{Binding PreviewTitle}" TextTrimming="CharacterEllipsis" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource PickText}" FontSize="12" Margin="0,2,0,0" IsChecked="{Binding Elements.ShowCaption}"
                                  HorizontalAlignment="Left" ToolTip="{Binding Elements.CaptionLabel}" AutomationProperties.Name="{Binding Elements.CaptionLabel}">
                        <TextBlock Text="{Binding PreviewArtist}" TextTrimming="CharacterEllipsis" />
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <!-- Controls -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <ToggleButton Style="{StaticResource PickGlyph}" IsChecked="{Binding Elements.ShowShuffle}" Content="&#xE8B1;" ToolTip="{DynamicResource Loc.Shuffle}" AutomationProperties.Name="{DynamicResource Loc.Shuffle}" />
                <ToggleButton Style="{StaticResource PickGlyph}" IsChecked="{Binding Elements.ShowPrevious}" Content="&#xE892;" ToolTip="{DynamicResource Loc.Previous}" AutomationProperties.Name="{DynamicResource Loc.Previous}" />
                <ToggleButton Style="{StaticResource PickPlay}" IsChecked="{Binding Elements.ShowPlayPause}" Content="{Binding PreviewPlayGlyph}" Width="34" Height="34" Margin="8,0"
                              ToolTip="{DynamicResource Loc.PlayPause}" AutomationProperties.Name="{DynamicResource Loc.PlayPause}" />
                <ToggleButton Style="{StaticResource PickGlyph}" IsChecked="{Binding Elements.ShowNext}" Content="&#xE893;" ToolTip="{DynamicResource Loc.Next}" AutomationProperties.Name="{DynamicResource Loc.Next}" />
                <ToggleButton Style="{StaticResource PickGlyph}" IsChecked="{Binding Elements.ShowRepeat}" Content="&#xE8EE;" ToolTip="{DynamicResource Loc.Repeat}" AutomationProperties.Name="{DynamicResource Loc.Repeat}" />
                <ToggleButton Style="{StaticResource PickGlyph}" IsChecked="{Binding Elements.ShowVolume}" Content="&#xE995;"
                              ToolTip="{DynamicResource Loc.MixerVolume}" AutomationProperties.Name="{DynamicResource Loc.Volume}" />
                <ToggleButton Style="{StaticResource PickGlyph}" IsChecked="{Binding Elements.ShowLike}" Content="&#xEB51;"
                              ToolTip="{DynamicResource Loc.LikeButton}" AutomationProperties.Name="{DynamicResource Loc.LikeButton}" />
            </StackPanel>

            <!-- Lyrics: always shown, so not a toggle. -->
            <StackPanel Margin="0,10,0,10" IsHitTestVisible="False" ToolTipService.IsEnabled="False">
                <Border Height="5" Width="150" CornerRadius="2.5" Background="#26FFFFFF" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding PreviewLyric}" FontSize="12" FontWeight="SemiBold" Foreground="#E6FFFFFF"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,7" />
                <Border Height="5" Width="190" CornerRadius="2.5" Background="#26FFFFFF" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Progress -->
            <ToggleButton Style="{StaticResource PickProgress}" IsChecked="{Binding Elements.ShowProgress}"
                          ToolTip="{DynamicResource Loc.Progress}" AutomationProperties.Name="{DynamicResource Loc.Progress}" />
        </StackPanel>
    </Border>
</UserControl>
