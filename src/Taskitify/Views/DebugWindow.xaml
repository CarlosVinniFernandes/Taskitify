<Window x:Class="Taskitify.Views.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.DiagnosticsTitle}"
        Width="720" Height="560"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/Taskitify.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBox x:Name="StateText" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource PopupBorderBrush}" Padding="6" TextWrapping="Wrap" />
        <TextBox x:Name="LogText" Grid.Row="1" Margin="0,8,0,0" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                 Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                 BorderBrush="{DynamicResource PopupBorderBrush}" Padding="6"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
    </Grid>
</Window>
