# Public site settings, read by the server. Leave unset until confirmed.
SITE_URL=
CONTACT_EMAIL=

# Connect a PRIVATE Vercel Blob store to the project.
BLOB_READ_WRITE_TOKEN=
# Stable secret, at least 32 characters. Generate a different value for each environment.
SUGGESTION_RATE_SECRET=

# The Lyrics Studio share viewer is enabled by default in next dev.
# Set this to 1 before building a non-production preview.
LYRICS_SHARE_EXPERIMENT=
