# Public site settings, read by the server. Leave unset until confirmed.
SITE_URL=
CONTACT_EMAIL=

# Connect a PRIVATE Vercel Blob store to the project.
BLOB_READ_WRITE_TOKEN=
# Stable secret, at least 32 characters. Generate a different value for each environment.
SUGGESTION_RATE_SECRET=
# Set to 0 to pause the wall while continuing to accept private suggestions.
COMMUNITY_WALL_ENABLED=1

# Optional server-only key for /community/admin. Use 32 random bytes in Base64URL.
COMMUNITY_ADMIN_KEY=

# The Lyrics Studio share viewer is enabled by default in next dev.
# Set this to 1 before building a non-production preview.
LYRICS_SHARE_EXPERIMENT=

# Enable the short-link API only in local development or a restricted preview.
LYRICS_SHORT_LINK_EXPERIMENT=
# Server-only secret, at least 32 characters. Used for short-lived rate-limit identifiers.
SHARE_CODE_RATE_SECRET=
# Optional server-side limits for new links.
SHARE_CODE_MAX_LENGTH=6000
SHARE_CODE_DAILY_LIMIT=15
SHARE_CODE_IP_WINDOW_SECONDS=600
